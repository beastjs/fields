import { useEffect } from 'octane'
import { mountPlayground } from './playground/app'

setup useEffect(() => mountPlayground(), []);

main.playground
  header.topbar
    a.brand(href='/' aria-label='Beast Playground home')
      img(src='/beast.svg' alt='' width='25' height='25')
      strong beast
      span.brand-divider /
      span.brand-product playground
      span.milestone ALPHA
    div.topbar-actions
      span.local-label
        span.status-dot
        | Runs in your browser
      button#run-build.run-button(type='button' title='Run project (⌘/Ctrl + Enter)')
        span.play-icon ▷
        | Run project
        kbd ⌘ ↵
  div.workspace-heading
    div.project-title
      span.project-symbol ◈
      span Hello world
      span.project-kind BTSX PROJECT
    div.pipeline-label
      span Beast
      span.arrow →
      span Octane
      span.arrow →
      span Web
  section.workspace(aria-label='Playground workspace')
    aside.explorer(aria-label='File explorer')
      div.panel-heading
        span EXPLORER
        button#add-file.icon-button(type='button' aria-label='Add file' title='Add file') +
      form#new-file-form.new-file-form(hidden={true})
        label(for='new-file-name') New file path
        input#new-file-name(type='text' placeholder='src/Component.btsx' autocomplete='off')
        button(type='submit') Add
        button#cancel-file(type='button') Cancel
      p#file-error.file-error(role='alert' hidden={true})
      div.folder-label
        span ▾
        span.folder-icon ▱
        | src
      div#file-list.file-list
      div.explorer-note
        span.status-dot
        span In-memory project
        p Your files stay in this tab.
    section.editor-pane(aria-label='Code editor')
      div#editor-tabs.editor-tabs(role='tablist' aria-label='Open files')
      div.editor-breadcrumb
        span src
        span ›
        span#active-filename App.btsx
        span#language-label.language-label Beast
      div#editor.editor-mount
      div.editor-footer
        span#editor-file-info BTSX
        span UTF-8
        button#vim-toggle.editor-vim-toggle(type='button' aria-label='Vim mode' aria-pressed='false' title='Enable Vim keybindings') VIM
        span.editor-hint ⌘ ↵ to run · edits compile automatically
    section.preview-pane(aria-label='Application preview')
      div.preview-toolbar
        div.preview-label
          span.status-dot
          strong Preview
        div.viewport-controls(role='group' aria-label='Preview size')
          button.viewport-button.active(type='button' data-width='100%' aria-label='Desktop preview' aria-pressed='true' title='Desktop') ▰
          button.viewport-button(type='button' data-width='768px' aria-label='Tablet preview' aria-pressed='false' title='Tablet') ▯
          button.viewport-button(type='button' data-width='375px' aria-label='Mobile preview' aria-pressed='false' title='Mobile') ▯
        button#reload-preview.icon-button(type='button' aria-label='Reload preview' title='Reload preview') ↻
      div.preview-address
        span ◇
        span playground.local
        span#preview-status.preview-status Starting
      div.preview-stage
        iframe#preview-frame(title='Application preview' sandbox='allow-scripts')
        div#preview-overlay.preview-overlay(role='status')
          span.overlay-symbol ◈
          strong Preparing your preview
          p The first build starts automatically.
      div#preview-error.preview-error(role='alert' hidden={true})
  section.bottom-panel(aria-label='Developer tools')
    div.tools-toolbar
      div.tools-tabs(role='tablist' aria-label='Developer tools')
        button.tool-tab.active(type='button' role='tab' data-panel='problems' aria-selected='true' aria-controls='problems-panel')
          | Problems
          span#problem-count.count 0
        button.tool-tab(type='button' role='tab' data-panel='console' aria-selected='false' aria-controls='console-panel')
          | Console
          span#console-count.count 0
        button.tool-tab(type='button' role='tab' data-panel='output' aria-selected='false' aria-controls='output-panel') Generated code
      button#clear-console.clear-button(type='button' hidden={true}) Clear console
      span#build-summary.build-summary Waiting for first build
    div#problems-panel.tools-content(role='tabpanel')
      div#problems-list
    div#console-panel.tools-content(role='tabpanel' hidden={true})
      div#console-list
    div#output-panel.tools-content.output-content(role='tabpanel' hidden={true})
      div.output-stage-buttons
        button.output-stage.active(type='button' data-stage='octane') Octane / TSRX
        button.output-stage(type='button' data-stage='web') Web / JavaScript
      pre#generated-code
  footer.statusbar
    div.statusbar-left
      span#build-dot.status-dot
      span#build-status(aria-live='polite') Initializing compiler
    div#stage-timings.stage-timings
      span Beast —
      span Octane —
      span Web —
    span.toolchain Beast 0.2.60 · Octane 0.2.6
