import { fileRecommendation } from '../../chat/recommendation'
import { MAX_ATTEMPTS } from '../../chat/iterate'
import type { PlaygroundSession } from '../../playground/session'
import { useEffect, useRef, useState } from 'octane'
import { renderChatMarkdown } from '../../chat/markdown'
import type { ChatMessage } from '../../chat/controller'
import Accordion, {AccordionItem, AccordionTrigger, AccordionPanel} from "../ui/accordion.btsx";


module
  interface ChatMessageProps { message: ChatMessage; session: PlaygroundSession, auto: boolean, onAutoFailure?: (message: ChatMessage, error: string) => void }
props { message, session, auto, onAutoFailure }: ChatMessageProps
setup
  const recommendation = message.state === 'complete' ? fileRecommendation(message.content, message.context) : undefined;
  const [applyState, setApplyState] = useState('');
  const [applyError, setApplyError] = useState('');
  const pending = useRef<AbortController | null>(null);
  useEffect(() => () => pending.current?.abort(), []);

  // `automatic` marks auto-apply runs, whose failures are fed back to the model.
  const apply = async (automatic = false) => {
    if (!recommendation?.source || !message.context || message.projectGeneration === undefined || pending.current || applyState === 'Applied and compiled successfully') return;
    const abort = new AbortController();
    pending.current = abort;
    setApplyError('');
    setApplyState('Checking compilation…');
    try {
      await session.applyRecommendation(recommendation.file, message.context.source, recommendation.source, message.projectGeneration, abort.signal);
      setApplyState('Applied and compiled successfully');
    } catch (error) {
      setApplyState('');
      const reason = error instanceof Error ? error.message : 'Could not verify this change.';
      setApplyError('Not applied. ' + reason);
      if (automatic) onAutoFailure?.(message, reason);
    } finally { pending.current = null; }
  };

  // Captured when this message first renders: toggling auto-apply later must not
  // retroactively apply earlier responses.
  const autoOnArrival = useRef(auto);
  const autoApplied = useRef(false);
  useEffect(() => {
    if (!autoOnArrival.current || autoApplied.current) return;
    if (message.state !== 'complete' || !recommendation?.source || message.projectGeneration === undefined) return;
    autoApplied.current = true;
    void apply(true);
  }, [message.id, message.state, message.projectGeneration, recommendation?.file]);

  // A change that cannot even be applied (no match, wrong file, cut off) is fed back the same way.
  const errorReported = useRef(false);
  useEffect(() => {
    if (!autoOnArrival.current || errorReported.current || message.state !== 'complete' || !recommendation?.error) return;
    errorReported.current = true;
    onAutoFailure?.(message, recommendation.error);
  }, [message.id, message.state, recommendation?.error]);
  const exhausted = autoOnArrival.current && (message.attempt ?? 1) >= MAX_ATTEMPTS && !!(recommendation?.error || applyError);

  const [copied, setCopied] = useState(false);
  const copy = async () => { try { await navigator.clipboard.writeText(message.content); setCopied(true); } catch { setCopied(false); } };

article(className={'chat-message ' + message.role} data-message-state={message.state})
  div.message-heading

    span.message-avatar #{message.role === 'user' ? '↗' : '✦'}
    strong #{message.role === 'user' ? (message.attempt ? 'Auto-fix' : 'You') : 'Assistant'}
    if message.attempt && message.attempt > 1
      span.message-state #{'ATTEMPT ' + message.attempt + '/' + MAX_ATTEMPTS}
    if message.role === 'assistant'
      span.message-state #{message.state === 'streaming' ? 'WORKING' : message.state === 'stopped' ? 'STOPPED' : message.state === 'error' ? 'INTERRUPTED' : 'DONE'}
  if message.role === 'user'
    p.user-message #{message.content}
    if message.attachments
      div.message-attachments
        each file in message.attachments key file
          code(title={file}) #{file.replace(/^\/src\//, '')}
  elseif message.content
    div.chat-markdown(dangerouslySetInnerHTML={{ __html: renderChatMarkdown(message.content, message.context?.source) }})
  elseif message.state === 'streaming'
    div.thinking-indicator(role='status')
      span
      span
      span
      | Working on it…
  if message.content && message.role === 'assistant' && message.state !== 'streaming'
    div.message-actions
      button(type='button' onClick={copy} aria-label='Copy response') #{copied ? 'Copied' : 'Copy response'}

  if recommendation && message.projectGeneration !== undefined
    div.chat-apply
      span.apply-target #{recommendation.file}
      if recommendation.hunks
        span.apply-scope #{recommendation.hunks}
      if recommendation.error
        p.chat-apply-error(role='alert') #{recommendation.error}
      else
        if !applyState
          button.secondary-button(type='button' onClick={() => apply()} disabled={!!applyState}) #{applyState === 'Checking compilation…' ? (autoOnArrival.current ? 'Auto-applying…' : 'Checking compilation…') : applyState ? 'Applied' : 'Apply & verify'}
            p(role='status') #{applyState}
        else
          span(className='space-x-1')
            span.apply-scope(className='text-accent') applied
            span.apply-scope(className='text-accent') compiled
        if applyError
          p.chat-apply-error(role='alert') #{applyError}
      if exhausted
        p.chat-apply-error(role='status') #{'Stopped auto-fixing after ' + MAX_ATTEMPTS + ' attempts. Adjust the request and try again.'}
