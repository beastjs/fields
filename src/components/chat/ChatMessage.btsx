import { fileRecommendation } from '../../chat/recommendation'
import type { PlaygroundSession } from '../../playground/session'
import { useEffect, useRef, useState } from 'octane'
import { renderChatMarkdown } from '../../chat/markdown'
import type { ChatMessage } from '../../chat/controller'


module
  interface ChatMessageProps { message: ChatMessage; session: PlaygroundSession, auto: boolean }
props { message, session, auto }: ChatMessageProps
setup
  const recommendation = message.state === 'complete' ? fileRecommendation(message.content, message.context) : undefined;
  const [applyState, setApplyState] = useState('');
  const [applyError, setApplyError] = useState('');
  const pending = useRef<AbortController | null>(null);
  useEffect(() => () => pending.current?.abort(), []);

  const apply = async () => {
    if (!recommendation || !message.context || message.projectGeneration === undefined || pending.current || applyState === 'Applied and compiled successfully') return;
    const abort = new AbortController();
    pending.current = abort;
    setApplyError('');
    setApplyState('Checking compilation…');
    try {
      await session.applyRecommendation(recommendation.file, message.context.source, recommendation.source, message.projectGeneration, abort.signal);
      setApplyState('Applied and compiled successfully');
    } catch (error) {
      setApplyState('');
      setApplyError('Not applied. ' + (error instanceof Error ? error.message : 'Could not verify this change.'));
    } finally { pending.current = null; }
  };

  useEffect(() => {
    if(auto && applyState){
      apply().catch(e => console.error(e))
    }
  }, [auto, apply])

  const [copied, setCopied] = useState(false);
  const copy = async () => { try { await navigator.clipboard.writeText(message.content); setCopied(true); } catch { setCopied(false); } };

article(className={'chat-message ' + message.role} data-message-state={message.state})
  div.message-heading
    span.message-avatar #{message.role === 'user' ? '↗' : '✳'}
    strong #{message.role === 'user' ? 'You' : 'Assistant'}
    if message.role === 'assistant'
      span.message-state #{message.state === 'streaming' ? 'WORKING' : message.state === 'stopped' ? 'STOPPED' : message.state === 'error' ? 'INTERRUPTED' : 'DONE'}
  if message.role === 'user'
    p.user-message #{message.content}
  elseif message.content
    div.chat-markdown(dangerouslySetInnerHTML={{ __html: renderChatMarkdown(message.content) }})
  elseif message.state === 'streaming'
    div.thinking-indicator(role='status')
      span
      span
      span
      | Working on it…
  if message.content && message.role === 'assistant' && message.state !== 'streaming'
    div.message-actions
      button(type='button' onClick={copy} aria-label='Copy response') #{copied ? 'Copied' : 'Copy response'}

  if recommendation && message.projectGeneration !== undefined
    div.chat-apply
      span.apply-target #{recommendation.file}
      button.secondary-button(type='button' onClick={apply} disabled={!!applyState}) #{applyState === 'Checking compilation…' ? 'Checking compilation…' : applyState ? 'Applied' : 'Apply & verify'}
      if applyState
        p(role='status') #{applyState}
      if applyError
        p.chat-apply-error(role='alert') #{applyError}
