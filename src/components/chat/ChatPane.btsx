import { useEffect, useMemo, useRef, useState, useSyncExternalStore } from 'octane'
import { ChatController } from '../../chat/controller'
import { readChatSettings, saveChatSettings } from '../../chat/settings'
import PaneSurface from '../layout/PaneSurface.btsx'
import CollapseButton from '../layout/CollapseButton.btsx'
import PaneReorderHandle from '../layout/PaneReorderHandle.btsx'
import ChatSettings from './ChatSettings.btsx'
import ChatComposer from './ChatComposer.btsx'
import ChatMessage from './ChatMessage.btsx'
import { fixUpPrompt } from '../../chat/iterate'
import type { ChatMessage as Message } from '../../chat/controller'
import {Icon} from '@/lib/icons'
import type { WorkspaceProps } from '../types'

props { layout, session }: WorkspaceProps
setup
  const chat = useMemo(() => new ChatController(readChatSettings(), saveChatSettings), []);
  const state = useSyncExternalStore(chat.subscribe, chat.getSnapshot);
  const [settingsOpen, setSettingsOpen] = useState(false);
  const scroller = useRef<HTMLDivElement | null>(null);
  const follow = useRef(true);
  const connected = !!state.settings.apiKey || !!state.status?.configured[state.settings.provider] || (state.settings.provider === 'custom' && !!state.settings.baseURL);
  useEffect(() => { void chat.checkConnection(); return () => chat.dispose(); }, [chat]);
  useEffect(() => { if (state.messages.length && follow.current && scroller.current) scroller.current.scrollTop = scroller.current.scrollHeight; }, [state.messages]);
  const scroll = () => { const node = scroller.current!; follow.current = node.scrollHeight - node.scrollTop - node.clientHeight < 80; };
  const [isAutoApply, setIsAutoApply] = useState(true)
  const toggleAuto = () => setIsAutoApply(v => !v)
  const autoRef = useRef(isAutoApply)
  autoRef.current = isAutoApply
  // Auto-apply failures go back to the model with the current file until a change applies
  // cleanly or the attempts run out. Only the latest reply iterates, and only while auto is on.
  const autoFix = (message: Message, error: string) => {
    // The reply is marked complete just before the controller clears `busy`; wait for idle.
    if (chat.getSnapshot().busy) {
      const unsubscribe = chat.subscribe(() => { if (!chat.getSnapshot().busy) { unsubscribe(); autoFix(message, error); } });
      return;
    }
    if (!autoRef.current || chat.getSnapshot().messages.at(-1)?.id !== message.id || !message.context) return;
    const prompt = fixUpPrompt(error, message.context.file, message.attempt ?? 1);
    const source = session.read(message.context.file);
    if (!prompt || source === undefined) return;
    const references = chat.lastReferences.flatMap(reference => {
      const current = session.read(reference.file);
      return current === undefined ? [] : [{ file: reference.file, source: current }];
    });
    void chat.submit(prompt, { file: message.context.file, source }, session.getSnapshot().projectGeneration, references, (message.attempt ?? 1) + 1);
  }


PaneSurface(layout={layout} pane='chat' label='AI chat' className='chat-pane')
  div(className='h-9 flex items-center justify-between border-b border-[var(--edge)] px-1 text-xs ')
    div.panel-title
      PaneReorderHandle(pane='chat')
      div(className='flex items-center gap-1 text-[11px]')
        span(className='opacity-70') ✦
        span(className='') Assistant
    div.panel-actions
      button.icon-button(type='button' title='New chat' aria-label='New chat' onClick={chat.clear})
        Icon(name='plus' className='size-3.5')
      button.icon-button(type='button' title='AI settings' aria-label='AI settings' onClick={() => setSettingsOpen(true)})
        Icon(name='settings' className='size-3.5')
      CollapseButton(layout={layout} pane='chat')
  button.chat-connection(type='button' onClick={() => setSettingsOpen(true)} aria-label='Configure AI provider and model')
    span.connection-led(data-connected={connected})
    span.model-name(title={state.settings.model}) #{state.settings.model.replace(/^cohere\//, '')}
    span.connection-label #{connected ? 'READY' : 'SETUP'}
  div.chat-history(ref={scroller} onScroll={scroll} role='log' aria-label='Chat messages' aria-live='polite')
    if !state.messages.length
      div.chat-welcome
        div.assistant-dial(aria-hidden={true}) ✦
        h2 Fast Builder
        each idea in ['Explore an idea', 'untangle an error', 'or find the next step'] key idea
          p(className='space-x-1')
            span(className='size-2 aspect-square rounded-full bg-background')
            span #{idea}
        button.connection-prompt(type='button' hidden={connected} onClick={() => setSettingsOpen(true)}) Set up your connection ↗
    each message in state.messages key message.id
      ChatMessage(message={message} session={session} auto={isAutoApply} onAutoFailure={autoFix})
    if state.error || state.connectionError
      div.chat-error(role='alert')
        p #{state.error || state.connectionError}
        div
          button.secondary-button(type='button' hidden={!state.connectionError} onClick={() => { void chat.checkConnection(); }}) Reconnect
          button.secondary-button(type='button' hidden={!state.error || state.busy} onClick={chat.retry}) Retry response
          button.secondary-button(type='button' onClick={() => setSettingsOpen(true)}) Settings
  ChatComposer(chat={chat} session={session} auto={isAutoApply} toggleAuto={toggleAuto})
  if settingsOpen
    ChatSettings(chat={chat} onClose={() => setSettingsOpen(false)})
