import { useEffect, useRef } from 'octane'
import type { ProjectTransfer } from './project-transfer'
import { dialogPanel, dialogActions, dialogHeading, dialogTitle, eyebrowLabel, iconButton, primaryButton, secondaryButton, sharedFile, sharedFiles, transferDescription, transferLabel, transferNote } from '../ui/styles'

props { transfer, onClose, onCopy, onImport }: { transfer: ProjectTransfer; onClose: () => void; onCopy: () => void; onImport: () => void }
setup
  const dialog = useRef<HTMLDialogElement | null>(null);
  const files = Object.entries(transfer.workspace?.project.files ?? {}).map(([path, source]) => ({ path, source }));
  useEffect(() => { dialog.current?.showModal(); return () => dialog.current?.close(); }, []);

dialog(className={dialogPanel} ref={dialog} aria-labelledby='project-transfer-title' onCancel={onClose})
  div(className={dialogHeading})
    div
      span(className={eyebrowLabel}) PROJECT
      h2#project-transfer-title(className={dialogTitle}) #{transfer.kind === 'share' ? 'Share project' : 'Open shared project'}
    button(className={iconButton} type='button' aria-label='Close project sharing' onClick={onClose}) ×
  if transfer.error
    p(className='text-[12px] leading-[1.7] text-warning' role='alert') #{transfer.error}
  elseif transfer.kind === 'share'
    div
      p(className={transferDescription}) This link contains a snapshot of your project files and preview size. Anyone with the link can read the files. Later edits need a new link.
      if transfer.url
        div
          label(className={transferLabel} for='project-share-url') Project link
          textarea#project-share-url(className='block w-full min-w-0 resize-none p-2.5 border border-edge-strong rounded-[4px] bg-inset text-fg-secondary font-code text-[10px]/[1.7] [overflow-wrap:anywhere]' readOnly={true} rows={4} value={transfer.url} onFocus={event => event.currentTarget.select()})
          p(className={transferNote}) Chat, connection credentials, and personal preferences are excluded. Files stay in the link; they are not uploaded to a project server.
      else
        p(className={transferNote} role='status') Creating link…
  elseif transfer.workspace
    div
      p(className={transferDescription}) Review these #{files.length} files before importing. This replaces your current files and the saved project in this browser.
      div(className={sharedFiles})
        each file in files key file.path
          details(className={sharedFile})
            summary #{file.path}
            pre #{file.source.slice(0, 20000)}
            if file.source.length > 20000
              p(className={transferNote}) Preview shortened. The complete file will be imported.
      p(className={transferNote}) Entry: #{transfer.workspace.project.entry}
  else
    p(className={transferNote} role='status') Reading shared project…
  if transfer.notice
    p(className={transferNote} role='status') #{transfer.notice}
  div(className={dialogActions})
    button(className={secondaryButton} type='button' onClick={onClose}) #{transfer.kind === 'import' ? 'Keep current project' : 'Close'}
    if transfer.kind === 'share' && transfer.url
      button(className={primaryButton} type='button' onClick={onCopy}) Copy link
    elseif transfer.kind === 'import' && transfer.workspace && !transfer.error
      button(className={primaryButton} type='button' onClick={onImport}) Replace project
