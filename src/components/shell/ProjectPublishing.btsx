import { useState } from 'octane'
import type { SessionProps } from '../types'
import type { CloudProjectId } from '../../playground/cloud-project-persistence'
import PublishDialog from './PublishDialog.btsx'
import {Icon} from '@/lib/icons'

props { session, projectId, projectName }: SessionProps & { projectId: CloudProjectId; projectName: string }
setup
  const [open, setOpen] = useState(false);

button(className='text-foreground/60 hover:text-foreground' type='button' aria-label='Publish project' title='Publish project' onClick={() => setOpen(true)})
  Icon(name='publish' className='size-5 text-accent')
if open
  PublishDialog(session={session} projectId={projectId} projectName={projectName} onClose={() => setOpen(false)})
