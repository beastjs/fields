import { useEffect, useRef, useState } from 'octane'
import { Icon } from '@/lib/icons'
import { useTheme } from '../theme/theme-context'
import { topbarTemplates, templatePreviewProject } from '../../playground/layout-templates'
import { TemplatePreview, type TemplatePreviewStatus } from '../../playground/template-preview'
import { cn } from '@/lib/utils'
import { dialogActions, dialogHeading, dialogPanel, dialogTitle, eyebrowLabel, iconButton, primaryButton, secondaryButton, transferDescription } from '../ui/styles'

props { compact = false }: { compact?: boolean }
setup
  const dialog = useRef<HTMLDialogElement | null>(null);
  const frame = useRef<HTMLIFrameElement | null>(null);
  const preview = useRef<TemplatePreview | null>(null);
  const [open, setOpen] = useState(false);
  const [selectedId, setSelectedId] = useState(topbarTemplates[0].id);
  const [view, setView] = useState<'preview' | 'source'>('preview');
  const [status, setStatus] = useState<TemplatePreviewStatus>({ state: 'compiling' });
  const [copied, setCopied] = useState(false);
  const { theme } = useTheme();
  const selected = topbarTemplates.find(template => template.id === selectedId) ?? topbarTemplates[0];
  const templateTab = 'px-2.5 py-1 rounded-[4px] text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg';
  const statusText = status.state === 'compiling' ? 'Compiling…' : status.state === 'error' ? status.message : selected.file.replace('/src/', '');

  const show = () => { setOpen(true); dialog.current?.showModal(); };
  const close = () => dialog.current?.close();
  const copySource = async () => {
    try { await navigator.clipboard.writeText(selected.source); setCopied(true); }
    catch { setCopied(false); }
  };

  // Escape and form-method dialogs close natively; keep `open` in sync with the element.
  useEffect(() => {
    const element = dialog.current;
    if (!element) return;
    const onClose = () => setOpen(false);
    element.addEventListener('close', onClose);
    return () => { element.removeEventListener('close', onClose); element.close(); };
  }, []);
  // The compiler worker and iframe runtime only exist while the builder is open.
  useEffect(() => {
    if (!open || !frame.current) return;
    const instance = new TemplatePreview(frame.current, theme, () => new Worker(new URL('../../playground/compiler.worker.ts', import.meta.url), { type: 'module' }), setStatus);
    preview.current = instance;
    return () => { instance.dispose(); preview.current = null; };
  }, [open]);
  useEffect(() => { preview.current?.show(templatePreviewProject(selected)); setCopied(false); }, [open, selected]);
  useEffect(() => { preview.current?.setTheme(theme); }, [theme]);

button(className='bg-muted/50 hover:bg-muted py-1.5 px-3 rounded-2xl' type='button' title={compact ? 'Open layout builder' : undefined} onClick={event => { event.currentTarget.focus(); show(); }})
  div(className='flex items-center justify-center rounded-full text-sm gap-1.5 text-muted-foreground')
    Icon(name='build' className='size-4.5')
    if !compact
      span(className='truncate capitalize' title={'Builder'}) Design Studio
dialog(className={cn(dialogPanel, 'w-[min(960px,calc(100vw-24px))]')} ref={dialog} aria-labelledby='layout-builder-title')
  div(className={dialogHeading})
    div
      span(className={eyebrowLabel}) WEB APPS
      div(className='flex items-center gap-2')
        h2#layout-builder-title(className={dialogTitle}) Design Studio
        ol(className='flex gap-1.5 p-0 list-none text-[10px]' aria-label='Layout sections')
          li(className='px-2 py-0.5 border border-edge-strong rounded-full text-dim aria-[current=step]:border-brand aria-[current=step]:text-brand' aria-current='step') Topbar
    button(className={iconButton} type='button' aria-label='Close layout builder' onClick={close}) ×

  p(className={transferDescription}) Pick a topbar to start your layout. Each template is a Beast component styled with Tailwind — preview it live or read its source.
  div(className='grid grid-cols-[minmax(180px,240px)_minmax(0,1fr)] gap-3.5 mb-4 max-[700px]:grid-cols-[minmax(0,1fr)]')
    div(className='grid content-start gap-1.5 max-h-[400px] overflow-auto max-[700px]:max-h-[180px]' role='radiogroup' aria-label='Topbar templates')
      each template in topbarTemplates key template.id
        button(className='grid gap-1 px-3 py-2.5 text-left border border-edge rounded-[5px] bg-surface-recessed text-fg hover:bg-surface-hover aria-checked:border-brand aria-checked:shadow-[inset_2px_0_var(--brand)]' type='button' role='radio' aria-checked={template.id === selected.id} onClick={() => setSelectedId(template.id)})
          span(className='text-[12px]') #{template.title}
          span(className='text-[10px] leading-[1.6] text-dim') #{template.description}
    div(className='grid grid-rows-[auto_1fr] min-w-0 overflow-hidden border border-edge rounded-[5px] bg-inset')
      div(className='flex items-center justify-between gap-3 px-2 py-1.5 border-b border-edge bg-surface-toolbar')
        div(className='flex gap-0.5' role='tablist' aria-label='Template view')
          button(className={templateTab} type='button' role='tab' aria-selected={view === 'preview'} onClick={() => setView('preview')}) Preview
          button(className={templateTab} type='button' role='tab' aria-selected={view === 'source'} onClick={() => setView('source')}) Source
        span(className='min-w-0 truncate font-code text-[10px] text-faint data-[state=error]:text-warning' role='status' data-state={status.state}) #{statusText}
      iframe(className='m-0 h-[360px] w-full border-0' ref={frame} title={`${selected.title} topbar preview`} hidden={view !== 'preview'})
      if view === 'source'
        pre(className='m-0 h-[360px] w-full overflow-auto p-3 font-code text-[10px]/[1.7] text-fg-secondary') #{selected.source}
  div(className={dialogActions})
    button(className={secondaryButton} type='button' onClick={copySource}) #{copied ? 'Copied' : 'Copy source'}
    button(className={primaryButton} type='button' onClick={close}) Done
