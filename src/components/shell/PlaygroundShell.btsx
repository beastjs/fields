import { useEffect, useMemo } from 'octane'
import { useQueryStates } from '@octanejs/nuqs'
import { panelQueryParsers } from '../../playground/panel-query'
import { createPlaygroundSession } from '../../playground/app'
import { WorkspaceLayout } from '../../playground/workspace-layout'
import Topbar from './Topbar.btsx'
import ProjectHeading from './ProjectHeading.btsx'
import Statusbar from './Statusbar.btsx'
import ViewToolbar from '../layout/ViewToolbar.btsx'
import Workspace from '../layout/Workspace.btsx'

setup
  const [query, setQuery] = useQueryStates(panelQueryParsers, { history: 'replace', shallow: true, scroll: false });
  const session = useMemo(() => createPlaygroundSession(), []);
  const layout = useMemo(() => new WorkspaceLayout(matchMedia('(max-width: 760px)').matches, query), []);
  useEffect(() => { session.start(); return () => session.dispose(); }, [session]);
  useEffect(() => layout.connectPersistence(value => { void setQuery(value); }), [layout, setQuery]);
  useEffect(() => layout.restore(query), [layout, query.dock, query.split, query.rows]);

main.playground
  Topbar(session={session})
  ProjectHeading
  ViewToolbar(layout={layout})
  Workspace(session={session} layout={layout})
  Statusbar(session={session})
