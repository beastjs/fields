import type { CompilationResult } from '../../playground/contracts'

props { result }: { result?: CompilationResult }
setup
  const timings = result?.metadata.timings;
  const card = 'min-w-0 rounded-[4px] border border-edge bg-surface-hover px-[15px] py-[11px] shadow-[inset_0_1px_#5b5b5122] light:shadow-[inset_0_1px_#fff9,0_1px_2px_#4e473b0d] max-[760px]:px-3 max-[760px]:py-[9px] output-short:px-3 output-short:py-[7px]';
  const label = 'font-sans text-[10px] text-fg-secondary output-short:text-[9px]';
  const value = 'mt-[9px] mb-[7px] font-code text-[28px] leading-none tracking-[-1px] text-fg tabular-nums max-[760px]:text-[22px] output-short:mt-1.5 output-short:mb-1 output-short:text-[22px]';

div(className='grid grid-cols-4 gap-[3px] max-[760px]:grid-cols-2' aria-label='Build measurements')
  div(className={card})
    span(className={label}) Components
    div(className={value}) #{result ? String(result.metadata.transformedFiles).padStart(2, '0') : '—'}
    span(className='text-[7px] tracking-[.7px] text-faint output-short:hidden') IN THE MODULE GRAPH
  each stage in ['beast', 'octane', 'web'] as const key stage
    div(className={card})
      span(className={label}) #{stage === 'beast' ? 'Beast transform' : stage === 'octane' ? 'Octane compile' : 'Web output'}
      div(className={value})
        | #{timings ? timings[stage].toFixed(1) : '—'}
        small(className='ml-1.5 text-[10px] tracking-normal text-faint') ms
      div(className='mt-2.5 h-0.5 bg-inset output-short:mt-1.5' aria-hidden={true})
        span(className='block h-full max-w-full bg-brand' style={{ width: timings ? Math.max(1, timings[stage] / Math.max(1, timings.beast + timings.octane + timings.web) * 100) + '%' : '0%' }})
