import { canNavigateRuntimeLocation } from '../../playground/runtime-diagnostics'
import type { RuntimeLocation } from '../../playground/runtime-diagnostics'
import { fileLabel } from '../../playground/presentation'
import type { PlaygroundSession, SessionSnapshot } from '../../playground/session'
import type { NavigateToSource } from '../types'
import { cn } from '@/lib/utils'

props { session, state, navigate }: { session: PlaygroundSession; state: SessionSnapshot; navigate: NavigateToSource }
setup
  const open = (location: RuntimeLocation) => {
    if (canNavigateRuntimeLocation(location, session.read(location.file))) navigate(location.file, location.position);
  };

div#console-list
  if !state.console.length
    p Console output from your application appears here.
  each entry in state.console key entry.id
    div(className='flex gap-3 border-b border-control py-1.5' data-level={entry.level})
      span(className='text-faint') #{new Date(entry.timestamp).toLocaleTimeString('en-GB')}
      span(className='w-[35px] shrink-0 text-fg-secondary') #{entry.level}
      div(className='min-w-0 flex-1')
        div(className={cn('console-message whitespace-pre-wrap text-fg-secondary [overflow-wrap:anywhere]', entry.level === 'error' && 'text-[#e9b98f] light:text-destructive', entry.level === 'warn' && 'text-[#e2c278] light:text-notice')}) #{entry.message}
        if entry.frames?.length
          div(className='mt-1.5 flex flex-col items-start gap-[3px]')
            each frame, index in entry.frames key index
              if frame.location
                button(className='runtime-source-link border-0 bg-none py-0.5 text-left text-[#f2a06c] underline underline-offset-3 [overflow-wrap:anywhere] light:text-brand disabled:cursor-default disabled:text-faint disabled:no-underline' type='button' disabled={!canNavigateRuntimeLocation(frame.location, state.project.files[frame.location.file])} onClick={() => open(frame.location!)} title={canNavigateRuntimeLocation(frame.location, state.project.files[frame.location.file]) ? 'Open source location' : 'This stack frame belongs to an older version of the file.'}) #{fileLabel(frame.location.file)}:#{frame.location.position.line}:#{frame.location.position.column}#{canNavigateRuntimeLocation(frame.location, state.project.files[frame.location.file]) ? '' : ' (source changed)'}
              else
                div(className='max-w-full whitespace-pre-wrap text-[9px] text-faint [overflow-wrap:anywhere]') #{frame.raw}
