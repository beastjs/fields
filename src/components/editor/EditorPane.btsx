import { useEffect, useRef, useSyncExternalStore } from 'octane'
import { connectEditor } from '../../playground/editor-connection'
import { fileLabel, fileLanguage, navigateTabs } from '../../playground/presentation'
import PaneSurface from '../layout/PaneSurface.btsx'
import CollapseButton from '../layout/CollapseButton.btsx'
import type { WorkspaceProps } from '../types'

props { session, layout }: WorkspaceProps
setup
  const state = useSyncExternalStore(session.subscribe, session.getSnapshot);
  const mount = useRef<HTMLDivElement | null>(null);
  useEffect(() => connectEditor(mount.current!, session), [session]);

PaneSurface(layout={layout} pane='editor' label='Code editor' className='editor-pane')
  div.editor-toolbar
    div#editor-tabs.editor-tabs(role='tablist' aria-label='Open files' onKeyDown={navigateTabs})
      each path in Object.keys(state.project.files) key path
        button(type='button' className={'editor-tab' + (state.activeFile === path ? ' active' : '')} role='tab' aria-selected={state.activeFile === path} aria-controls='editor' tabIndex={state.activeFile === path ? 0 : -1} onClick={() => session.openFile(path)}) #{fileLabel(path)}
    CollapseButton(layout={layout} pane='editor')
  div.editor-breadcrumb
    span src
    span ›
    span#active-filename #{fileLabel(state.activeFile)}
    span#language-label.language-label #{fileLanguage(state.activeFile)}
  div#editor.editor-mount(ref={mount} data-keymap={state.keymap})
  div.editor-footer
    span#editor-file-info #{state.activeFile.split('.').at(-1)!.toUpperCase()}
    span UTF-8
    button#vim-toggle.editor-vim-toggle(type='button' aria-label='Vim mode' aria-pressed={state.keymap === 'vim'} title={state.keymap === 'vim' ? 'Disable Vim keybindings' : 'Enable Vim keybindings'} onClick={session.toggleKeymap}) VIM
    span.editor-hint #{state.keymap === 'vim' ? 'i to insert · Esc for normal · :w to run' : '⌘ ↵ to run · edits compile automatically'}
