import type { LandingActions } from '../types'

props { enter }: Pick<LandingActions, 'enter'>

footer(className='px-(--fl-gutter)')
  div(className='flex flex-wrap items-center justify-between gap-x-10 gap-y-4 px-4 py-8')
    span(className='flex items-center gap-2.5')
      img(className='opacity-80 invert light:invert-0' src='/beast.svg' alt='' width='18' height='18')
      span(className='text-[14px] font-medium tracking-[-0.01em]') Beast Playground
    nav(className='flex flex-wrap gap-x-7 gap-y-2 text-[13px]' aria-label='Footer')
      a(className='text-(--fl-dim) transition-colors hover:text-(--fl-ink)' href='#overview') Overview
      a(className='text-(--fl-dim) transition-colors hover:text-(--fl-ink)' href='#get-started') Get started
      a(className='text-(--fl-dim) transition-colors hover:text-(--fl-ink)' href='/playground' onClick={enter}) Open the playground
  div(className='flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-(--fl-rule) px-4 py-5 font-code text-[10px] tracking-[0.12em] text-(--fl-faint) uppercase')
    span © #{new Date().getFullYear()} Beast Playground
    span Runs entirely in your browser
