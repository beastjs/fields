import { Icon } from '@/lib/icons'
import { paneDefinitions } from '../../playground/panes'
import type { WorkbenchPaneId } from '../../playground/panes'
import { SortableItemHandle } from '../../lib/dnd/sortable.btsx'

props { pane }: { pane: WorkbenchPaneId }
setup
  const label = paneDefinitions.find(item => item.id === pane)!.label;

SortableItemHandle.pane-reorder-handle(
  ~ type='button'
  ~ data-reorder-handle={pane}
  ~ aria-label={'Reorder ' + label + ' pane'}
  ~ aria-keyshortcuts='Space ArrowLeft ArrowRight ArrowUp ArrowDown'
  ~ title={'Drag to reorder ' + label + ' · Space then arrow keys'}
  ~ )
  Icon(name='draggable' className='size-3.5')
