import { createElement, useEffect, useState, useSyncExternalStore } from 'octane'
import { Group, Panel, Separator } from '@octanejs/resizable-panels'
import Sortable, { SortableContent, SortableItem, SortableOverlay } from '../../lib/dnd/sortable.btsx'
import { isWorkbenchPaneId, paneDefinitions } from '../../playground/panes'
import type { WorkbenchPaneId } from '../../playground/panes'
import type { WorkspaceProps, NavigateToSource } from '../types'
import FilesPane from '../files/FilesPane.btsx'
import EditorPane from '../editor/EditorPane.btsx'
import PreviewPane from '../preview/PreviewPane.btsx'
import OutputPane from '../output/OutputPane.btsx'
import ChatPane from '../chat/ChatPane.btsx'

module
  const paneLabel = (id: WorkbenchPaneId) => paneDefinitions.find(pane => pane.id === id)!.label;
  const resizeLabel = (left: WorkbenchPaneId, right: WorkbenchPaneId) => {
    if (left === 'files' && right === 'editor') return 'Resize files';
    if (left === 'editor' && right === 'preview') return 'Resize editor and preview';
    if (left === 'preview' && right === 'chat') return 'Resize AI chat';
    return 'Resize ' + paneLabel(left).toLowerCase() + ' and ' + paneLabel(right).toLowerCase();
  };
  const paneDragPreview = ({ value }: { value: string | number }) => createElement(
    'div',
    { className: 'pane-drag-preview' },
    paneLabel(value as WorkbenchPaneId),
  );

props { session, layout }: WorkspaceProps
setup
  const [narrow, setNarrow] = useState(layout.narrow);
  const view = useSyncExternalStore(layout.subscribe, layout.getSnapshot);
  const navigate: NavigateToSource = (file, position) => {
    layout.expand('editor');
    session.openFile(file, position, position !== undefined);
  };
  const finishPaneDrag = (order: unknown[]) => {
    if (order.length === view.order.length && order.every(item => typeof item === 'string' && isWorkbenchPaneId(item))) {
      layout.setOrder(order as WorkbenchPaneId[]);
    }
  };
  useEffect(() => {
    const media = matchMedia('(max-width: 760px)');
    const change = () => { layout.setNarrow(media.matches); setNarrow(media.matches); };
    media.addEventListener('change', change);
    return () => media.removeEventListener('change', change);
  }, [layout]);

section.workspace(aria-label='Playground workspace')
  Group(id='workspace-group' orientation='vertical' groupRef={layout.groups.workspace} defaultLayout={layout.initialLayouts.workspace} onLayoutChange={layout.sync} onLayoutChanged={layout.commit})
    Panel(id='workbench' minSize='30%' className='panel-container')
      Sortable(value={[...view.order]} orientation={narrow ? 'vertical' : 'horizontal'} onValueChange={finishPaneDrag})
        SortableContent(withoutSlot={true})
          Group(id={'dock-group-' + view.order.join('-')} orientation={narrow ? 'vertical' : 'horizontal'} groupRef={layout.groups.dock} defaultLayout={layout.currentDockLayout()} onLayoutChange={layout.sync} onLayoutChanged={layout.commit})
            each pane, index in view.order key pane
              SortableItem(
                ~ id={'view-' + pane}
                ~ value={pane}
                ~ referenceProp='elementRef'
                ~ tabIndex={-1}
                ~ disabled={!view.draggingEnabled}
                ~ render={createElement(Panel, {
                ~   panelRef: layout.panels[pane],
                ~   minSize: pane === 'files' ? (narrow ? '20%' : '9%') : pane === 'chat' ? (narrow ? '45%' : '24%') : '20%',
                ~   maxSize: '100%',
                ~   collapsible: true,
                ~   collapsedSize: '0%',
                ~   className: 'panel-container',
                ~ })}
                ~ )
                if pane === 'files'
                  FilesPane(session={session} layout={layout} navigate={navigate})
                elseif pane === 'editor'
                  EditorPane(session={session} layout={layout})
                elseif pane === 'preview'
                  PreviewPane(session={session} layout={layout})
                else
                  ChatPane(layout={layout} session={session})
              if index < view.order.length - 1
                Separator(
                  ~ id={'resize-' + pane + '-' + view.order[index + 1]}
                  ~ className='pane-separator'
                  ~ aria-label={resizeLabel(pane, view.order[index + 1])}
                  ~ disabled={!view[pane] && !view[view.order[index + 1]]}
                  ~ )
        SortableOverlay(className='pane-drag-overlay' children={paneDragPreview})
    Separator(className='pane-separator' aria-label='Resize output')
    Panel(id='view-output' panelRef={layout.panels.output} minSize='12%' maxSize='70%' collapsible={true} collapsedSize='0%' className='panel-container')
      OutputPane(session={session} layout={layout} navigate={navigate})
