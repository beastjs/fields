import { useSyncExternalStore } from 'octane'
import { paneDefinitions } from '../../playground/workspace-layout'
import type { WorkspaceLayout } from '../../playground/workspace-layout'
import ButtonGroup from "../ui/button-group.btsx";
import FluidTooltip, {FluidTooltipRoot, FluidTooltipTrigger, FluidTooltipContent} from "../ui/fluid-tooltip.btsx";
import {Icon} from '@/lib/icons'
import {cn} from '@/lib/utils'

props { layout }: { layout: WorkspaceLayout }
setup const visible = useSyncExternalStore(layout.subscribe, layout.getSnapshot);

div.view-toolbar(role='group' aria-label='Workspace views')
  span.view-caption PANES
  FluidTooltip
    ButtonGroup
      each pane in paneDefinitions
        FluidTooltipRoot(id={pane.id})
          FluidTooltipTrigger(className='min-h-8 h-full w-9 whitespace-nowrap' asChild)
            button(type='button' data-view={pane.id} aria-controls={'pane-' + pane.id} aria-pressed={visible[pane.id]} onClick={() => layout.toggle(pane.id)} title={(visible[pane.id] ? 'Collapse ' : 'Expand ') + pane.label} disabled={visible[pane.id] && (pane.id === 'editor' ? !visible.preview : pane.id === 'preview' ? !visible.editor : false)})
              Icon(name={pane.icon} className={cn('size-3 opacity-50',{'opacity-100': visible[pane.id]} )})
          FluidTooltipContent(className='font-mono capitalize')
            | #{pane.id}
    // each pane in paneDefinitions key pane.id
    //   button.view-toggle(type='button' data-view={pane.id} aria-controls={'pane-' + pane.id} aria-pressed={visible[pane.id]} onClick={() => layout.toggle(pane.id)} title={(visible[pane.id] ? 'Collapse ' : 'Expand ') + pane.label} disabled={visible[pane.id] && (pane.id === 'editor' ? !visible.preview : pane.id === 'preview' ? !visible.editor : false)})
    //     span.view-indicator(aria-hidden={true})
    //     | #{pane.label}
  button.reset-layout(type='button' aria-label='Reset layout' onClick={layout.reset} title='Restore the default pane sizes and views') Reset
