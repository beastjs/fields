import { useSyncExternalStore } from 'octane'
import type { KeyboardEvent } from 'octane'
import { paneDefinitions } from '../../playground/panes'
import type { WorkbenchPaneId } from '../../playground/panes'
import type { WorkspaceLayout } from '../../playground/workspace-layout'
import ButtonGroup from '../ui/button-group.btsx'
import FluidTooltip, { FluidTooltipRoot, FluidTooltipTrigger, FluidTooltipContent } from '../ui/fluid-tooltip.btsx'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'

props { layout }: { layout: WorkspaceLayout }
setup
  const view = useSyncExternalStore(layout.subscribe, layout.getSnapshot);
  const orderedPanes = view.order.map(id => paneDefinitions.find(pane => pane.id === id)!);
  const output = paneDefinitions.find(pane => pane.id === 'output')!;
  const toggle = (id: WorkbenchPaneId) => {
    layout.toggle(id);
  };
  const moveWithKeyboard = (event: KeyboardEvent<HTMLButtonElement>, id: WorkbenchPaneId) => {
    if (!view.draggingEnabled || !event.altKey || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
    event.preventDefault();
    layout.move(id, event.key === 'ArrowLeft' ? -1 : 1);
  };

div.view-toolbar(role='group' aria-label='Workspace pane visibility and order')
  span.view-caption PANES
  FluidTooltip
    ButtonGroup(className='bg-background')
      each pane in orderedPanes key pane.id
        FluidTooltipRoot(id={pane.id})
          FluidTooltipTrigger(className='min-h-8 h-full w-9 whitespace-nowrap' asChild)
            button(
              ~ type='button'
              ~ className='pane-order-toggle'
              ~ data-view={pane.id}
              ~ aria-controls={'pane-' + pane.id}
              ~ aria-pressed={view[pane.id]}
              ~ aria-keyshortcuts='Alt+ArrowLeft Alt+ArrowRight'
              ~ onClick={() => toggle(pane.id)}
              ~ onKeyDown={event => moveWithKeyboard(event, pane.id)}
              ~ title={(view[pane.id] ? 'Collapse ' : 'Expand ') + pane.label + (view.draggingEnabled ? ' · Alt+←/→ to reorder' : '')}
              ~ disabled={view[pane.id] && !layout.canCollapse(pane.id)}
              ~ )
              Icon(name={pane.icon} className={cn('size-3.5 opacity-60', { 'opacity-100': view[pane.id] })})
          FluidTooltipContent(className='font-mono text-[10px]')
            | #{pane.label}#{view.draggingEnabled ? ' · Alt+←/→ to reorder' : ''}
      FluidTooltipRoot(id={output.id})
        FluidTooltipTrigger(className='min-h-8 h-full w-9 whitespace-nowrap' asChild)
          button(type='button' data-view={output.id} aria-controls={'pane-' + output.id} aria-pressed={view[output.id]} onClick={() => layout.toggle(output.id)} title={(view[output.id] ? 'Collapse ' : 'Expand ') + output.label})
            Icon(name={output.icon} className={cn('size-3 opacity-60', { 'opacity-100': view[output.id] })})
        FluidTooltipContent(className='font-mono text-[10px]') #{output.label}
  button.drag-mode-toggle(
    ~ type='button'
    ~ aria-label={view.draggingEnabled ? 'Disable pane dragging' : 'Enable pane dragging'}
    ~ aria-pressed={view.draggingEnabled}
    ~ title={view.draggingEnabled ? 'Disable pane dragging' : 'Enable pane dragging'}
    ~ onClick={layout.toggleDragging}
    ~ )
    Icon(name='draggable' className='size-3')
    span DRAG
    span.drag-mode-state #{view.draggingEnabled ? 'ON' : 'OFF'}
  button.reset-layout(type='button' aria-label='Reset layout' onClick={layout.reset} title='Restore the default pane sizes, order, and views') Reset
