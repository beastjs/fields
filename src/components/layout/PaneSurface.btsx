import { useSyncExternalStore } from 'octane'
import type { OctaneNode } from 'octane'
import type { PaneId } from '../../playground/panes'
import type { WorkspaceLayout } from '../../playground/workspace-layout'
import { cn } from '@/lib/utils'

props { layout, pane, label, className, children }: { layout: WorkspaceLayout; pane: PaneId; label: string; className: string; children?: OctaneNode }
setup const visible = useSyncExternalStore(layout.subscribe, layout.getSnapshot);

// Dragging may be disabled on the outer sortable panel; its live controls remain enabled.
section(id={'pane-' + pane} className={cn('relative size-full min-w-0 min-h-0 overflow-hidden rounded-xl data-[collapsed=true]:invisible light:border-[0.33px] light:border-edge', pane !== 'output' && 'arranging:visible! arranging:pointer-events-none arranging:h-[calc(100%/var(--pane-mini-scale))] arranging:w-[calc(100%/var(--pane-mini-scale))] arranging:max-h-none arranging:max-w-none arranging:origin-top-left arranging:scale-(--pane-mini-scale)', className)} aria-label={label} aria-disabled={!visible[pane] || visible.arranging} inert={!visible[pane] || visible.arranging} aria-hidden={!visible[pane] || visible.arranging} data-collapsed={!visible[pane]})
  | #{children}
