import { Icon } from '@/lib/icons'
import Sortable, { SortableContent, SortableItem, SortableItemHandle } from '@/lib/dnd/sortable.btsx'
import { sectionKind } from '../../playground/studio/kinds'
import type { PresetLookup, PresetRecipe } from '../../playground/studio/presets'
import type { PageBlock } from '../../playground/studio/page'
import RecipeCard from './RecipeCard.btsx'

module
  interface OutlineProps {
    blocks: PageBlock[]
    presets: PresetLookup
    recipes: PresetRecipe[]
    selected?: string
    onSelect: (name: string) => void
    onReorder: (blocks: PageBlock[]) => void
    onRemove: (name: string) => void
    onRecipe: (recipe: PresetRecipe) => void
  }

  const blockLabel = (block: PageBlock) => {
    const repeat = block.name.match(/\d+$/)?.[0];
    return sectionKind(block.kind).label + (repeat ? ' ' + repeat : '');
  }
  /** A section the studio did not compose, or whose preset has not loaded yet, has no design to name. */
  const designLabel = (block: PageBlock, presets: PresetLookup) =>
    (block.presetId === undefined ? undefined : presets.summary(block.presetId)?.title) ?? 'Edited in code'

props { blocks, presets, recipes, selected, onSelect, onReorder, onRemove, onRecipe }: OutlineProps

div(className='flex min-h-0 flex-col')
  div(className='flex items-center justify-between gap-2 border-b border-edge bg-inset px-3.5 h-9')
    h3(className='text-[12px] font-medium text-fg') Your page
    span(className='font-code text-[10px] text-dim') #{blocks.length} #{blocks.length === 1 ? 'section' : 'sections'}
  div(className='min-h-0 flex-1 overflow-auto p-2')
    if blocks.length
      div
        Sortable(value={blocks} getItemValue={(block: PageBlock) => block.name} onValueChange={onReorder})
          SortableContent(className='grid gap-1' aria-label='Page sections')
            each block, index in blocks key block.name
              SortableItem(
                ~ value={block.name}
                ~ tabIndex={-1}
                ~ data-selected={block.name === selected}
                ~ className='group/item flex items-center gap-1 rounded-[6px] border border-transparent bg-surface-recessed pr-1 transition-colors hover:border-edge data-dragging:z-10 data-dragging:border-brand data-dragging:shadow-elevation data-[selected=true]:border-brand/70 data-[selected=true]:bg-surface-hover'
                ~ )
                SortableItemHandle(aria-label={'Reorder ' + blockLabel(block)} className='flex h-10 w-6 shrink-0 items-center justify-center rounded-l-[6px] text-faint hover:text-fg')
                  Icon(name='draggable' className='size-3.5')
                button(type='button' className='flex min-w-0 flex-1 items-center gap-2 py-1.5 text-left' aria-current={block.name === selected ? 'true' : undefined} onClick={() => onSelect(block.name)})
                  span(className='w-4 shrink-0 font-code text-[10px] text-faint') #{String(index + 1).padStart(2, '0')}
                  span(className='min-w-0')
                    span(className='block truncate text-[12px] text-fg') #{blockLabel(block)}
                    span(className='block truncate text-[10px] text-dim') #{designLabel(block, presets)}
                button(type='button' aria-label={'Remove ' + blockLabel(block)} title='Remove from page' className='flex size-6 shrink-0 items-center justify-center rounded-full text-faint opacity-0 group-hover/item:opacity-100 group-data-[selected=true]/item:opacity-100 hover:bg-control hover:text-fg focus-visible:opacity-100' onClick={() => onRemove(block.name)})
                  Icon(name='close-small' className='size-3.5')
        p(className='px-1.5 pt-3 text-[10px] leading-[1.6] text-faint') Drag to reorder. Pick a section to see it in the preview and swap its design.
    else
      div(className='px-2 py-4 text-center')
        p(className='text-[12px] text-fg') Your page is empty
        p(className='mt-1 text-[10px] leading-[1.6] text-dim') Add sections from the library, or start from a recipe below.
    details(className='group/recipes mt-3 border-t border-edge pt-2' open={!blocks.length})
      summary(className='flex cursor-pointer list-none items-center gap-1.5 px-1.5 py-1.5 text-[11px] text-fg-secondary hover:text-fg [&::-webkit-details-marker]:hidden')
        Icon(name='sparkle' className='size-3 text-brand')
        span(className='flex-1') Start from a recipe
        Icon(name='chevron-down-tiny' className='size-3 -rotate-90 text-dim transition-transform group-open/recipes:rotate-0')
      div(className='grid gap-1.5 pt-1')
        each recipe in recipes key recipe.recipeId
          RecipeCard(recipe={recipe} onRecipe={onRecipe} compact={true})
