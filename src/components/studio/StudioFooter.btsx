import { cn } from '@/lib/utils'
import { primaryButton, secondaryButton } from '../ui/styles'
import { plural } from './studio'

module
  interface FooterProps {
    note: string
    /** Edits the install would overwrite, called out in the warning color. */
    overwriteNote: string
    editedNodes: number
    onClearDesign: () => void
    /** Offered only when there is a saved page to go back to. */
    canDiscard: boolean
    onDiscard: () => void
    onClose: () => void
    applyLabel: string
    canApply: boolean
    onApply: () => void
  }

props { note, overwriteNote, editedNodes, onClearDesign, canDiscard, onDiscard, onClose, applyLabel, canApply, onApply }: FooterProps

footer(className='flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-edge-strong px-5 py-2')
  p(className='min-w-0 flex-1 basis-80 text-[11px] leading-[1.6] text-dim' role='status')
    span #{note}
    if overwriteNote
      span(className='ml-1 text-warning') #{overwriteNote}
  div(className='flex min-w-0 flex-wrap items-center gap-[7px]')
    if editedNodes
      button(className='rounded-[5px] px-2 py-1 text-[10px] text-warning hover:bg-control' type='button' title='Drop every Fine Layout edit and go back to the presets' onClick={onClearDesign}) Reset #{plural(editedNodes, 'edit')}
    if canDiscard
      button(className={secondaryButton} type='button' onClick={onDiscard}) Discard changes
    button(className={secondaryButton} type='button' onClick={onClose}) Close
    button(className={cn(primaryButton, 'disabled:cursor-default disabled:opacity-60')} type='button' disabled={!canApply} onClick={onApply}) #{applyLabel}
