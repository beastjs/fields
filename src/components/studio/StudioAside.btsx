import { useState } from 'octane'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import type { PageBlock } from '../../playground/studio/page'
import type { PresetLookup } from '../../playground/studio/presets'
import type { ThemeDocument } from '../../playground/studio/themes'
import PageOutline from './PageOutline.btsx'
import ThemeDesigner from './ThemeDesigner.btsx'

module
  interface AsideProps {
    /**
     * Where the panel sits: the studio sizes it as a panel, or stacks it on a phone. Hiding it collapses rather than
     * unmounts it, so the theme designer keeps its brief, design and answers.
     */
    className?: string
    onBrowseFullstack: () => void
    onBrowseRecipes: () => void
    blocks: PageBlock[]
    presets: PresetLookup
    selected?: string
    onSelect: (name: string) => void
    onReorder: (blocks: PageBlock[]) => void
    onRemove: (name: string) => void
    theme: ThemeDocument
    onPreviewTheme: (theme: ThemeDocument) => void
  }

props { onBrowseFullstack, onBrowseRecipes, className, blocks, presets, selected, onSelect, onReorder, onRemove, theme, onPreviewTheme }: AsideProps
setup
  const [panel, setPanel] = useState<'outline' | 'theme'>('outline');

aside(className={cn('flex min-h-0 min-w-0 flex-col bg-panel', className)} aria-label='Page outline, theme, recipes and Fullstack')
  div(className='flex h-9 shrink-0 gap-0.5 overflow-x-auto border-b border-edge bg-surface-toolbar px-1.5 py-1.5' role='tablist' aria-label='Right panel')
    button(className='rounded-[4px] px-2 py-0.5 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={panel === 'outline'} onClick={() => setPanel('outline')}) Outline
    button(className='flex items-center gap-1 rounded-[4px] px-2 py-0.5 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={panel === 'theme'} onClick={() => setPanel('theme')})
      Icon(name='sparkle' className='size-2.5')
      span Theme
    button(className='rounded-[4px] px-2 py-0.5 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' data-recipes-trigger={true} aria-selected={false} onClick={onBrowseRecipes}) Recipes
    button(className='rounded-[4px] px-2 py-0.5 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' data-fullstack-trigger={true} aria-selected={false} onClick={onBrowseFullstack}) Fullstack
  if panel === 'theme'
    ThemeDesigner(onPreview={onPreviewTheme} current={theme})
  else
    PageOutline(blocks={blocks} presets={presets} selected={selected} onSelect={onSelect} onReorder={onReorder} onRemove={onRemove})
