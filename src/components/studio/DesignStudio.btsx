import { useEffect, useRef, useState, useSyncExternalStore } from 'octane'
import { Icon, type IconName } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { useTheme } from '../theme/theme-context'
import type { SessionProps } from '../types'
import { api } from '../../../convex/_generated/api'
import { useConvexQuery } from '@/hooks/use-convex-query'
import { sectionKind } from '../../playground/studio/kinds'
import { presetsFor } from '../../playground/studio/presets'
import type { PresetRecipe } from '../../playground/studio/presets'
import type { SectionKindId } from '../../playground/studio/types'
import { addSection, blockDocument, blockSource, composePage, PAGE_FILE, pagePresetIds, pagePreviewProject, planPageInstall, readNodeId, readPage, readProjectThemeId, recipeBlocks, samePage, sectionFile, swapPreset } from '../../playground/studio/page'
import { clearNodeOverride, mergeStyle, overrideCount, setNodeOverride } from '../../playground/studio/ir/overrides'
import { nodeIndex } from '../../playground/studio/ir/render'
import { toClasses } from '../../playground/studio/ir/classes'
import type { Style } from '../../playground/studio/ir/types'
import type { DesignNode } from '../../playground/preview'
import DesignOverlay, { type DesignEdit } from './DesignOverlay.btsx'
import { DEFAULT_PAINT, INHERIT_THEME, paintOf, readPaintedId, themeById, themeCss } from '../../playground/studio/themes'
import type { PaintStyle, ThemeDocument } from '../../playground/studio/themes'
import type { PageBlock } from '../../playground/studio/page'
import { TemplatePreview, type TemplatePreviewStatus } from '../../playground/template-preview'
import { dialogPanel, eyebrowLabel, iconButton, primaryButton, secondaryButton } from '../ui/styles'
import PageOutline from './PageOutline.btsx'
import SectionLibrary from './SectionLibrary.btsx'
import ThemeDesigner from './ThemeDesigner.btsx'
import { themeFromId } from '../../jev/theme-model'
import { isHuntedTheme, paintOfTheme, repaintTheme, themeFromHuntedId, themeFromPalette, type PaletteLike } from '../../playground/studio/colorhunt'
import { useConvex } from '@/hooks/use-convex'
import ThemePicker from './ThemePicker.btsx'
import Button from "../ui/button.btsx";

module
  type Device = 'desktop' | 'tablet' | 'mobile'
  // Each device renders at its real CSS width and scales down to fit, so breakpoints match what visitors see.
  const devices: { id: Device; label: string; icon: IconName; width: number }[] = [
    { id: 'desktop', label: 'Desktop', icon: 'desktop', width: 1280 },
    { id: 'tablet', label: 'Tablet', icon: 'tablet', width: 768 },
    { id: 'mobile', label: 'Mobile', icon: 'smartphone', width: 390 }
  ]
  const blockSelector = (index: number) => `[data-page] > :nth-child(${index + 1})`
  const fileLabel = (path: string) => path.replace('/src/', '')
  const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? '' : 's'}`
  // Either id form carries its style: a hunted palette in the id itself, any other theme as a `~style` suffix.
  const paintOfId = (themeId: string) => paintOfTheme(themeId) ?? readPaintedId(themeId)?.paint

props { session, compact = false }: SessionProps & { compact?: boolean }
setup
  const state = useSyncExternalStore(session.subscribe, session.getSnapshot);
  const { theme } = useTheme();
  const dialog = useRef<HTMLDialogElement | null>(null);
  // Two stacked frames: a reload renders in the hidden one and swaps in once painted (see TemplatePreview).
  const frame = useRef<HTMLIFrameElement | null>(null);
  const standby = useRef<HTMLIFrameElement | null>(null);
  const stage = useRef<HTMLDivElement | null>(null);
  const [stageSize, setStageSize] = useState({ width: 0, height: 0 });
  const preview = useRef<TemplatePreview | null>(null);
  const pendingReveal = useRef<{ name: string; highlight: boolean } | undefined>(undefined);
  const [open, setOpen] = useState(false);
  const [blocks, setBlocks] = useState<PageBlock[]>([]);
  const [selected, setSelected] = useState<string | undefined>(undefined);
  const [openKind, setOpenKind] = useState<SectionKindId | undefined>('topbar');
  const [device, setDevice] = useState<Device>('desktop');
  const [view, setView] = useState<'preview' | 'code'>('preview');
  const [codeFile, setCodeFile] = useState<'section' | 'page'>('section');
  const [status, setStatus] = useState<TemplatePreviewStatus>({ state: 'compiling' });
  const [copied, setCopied] = useState(false);
  const [themeId, setThemeId] = useState<string>(INHERIT_THEME.themeId);
  const [designing, setDesigning] = useState(false);
  const [asidePanel, setAsidePanel] = useState<'outline' | 'theme'>('outline');
  // Hides the side panels so the preview fills the dialog. Fine Layout keeps working: its button is in the
  // header and its overlay lives over the preview, neither of which the panels own.
  const [maximized, setMaximized] = useState(false);
  /**
   * Bumped whenever a preview instance is created.
   *
   * The rebuild effect below is keyed on what the page *is*, so a fresh instance with an unchanged page was never
   * asked to build anything: `show` is what moves the status off `compiling`, and nothing else ever calls it, so
   * the studio sat on "Building preview…" with no way back. Making the instance itself a dependency means every
   * preview that exists has been asked for a build.
   */
  const [previewEpoch, setPreviewEpoch] = useState(0);
  const maximizedRef = useRef(false);
  maximizedRef.current = maximized;
  /**
   * Themes designed in this session. They need no Convex row: a generated theme's id encodes every coordinate it
   * was composed from, so one already installed in a project is recomposed from its id on open.
   */
  const [generated, setGenerated] = useState<ThemeDocument[]>([]);
  /**
   * Palettes pulled from Color Hunt this session. Like a generated theme, a hunted one needs no Convex row: its
   * id carries the 24-character code, so all four colors are recoverable from the stylesheet alone.
   */
  const [hunted, setHunted] = useState<ThemeDocument[]>([]);
  /**
   * The feed page being walked. The first shuffle fetches 40 palettes and every shuffle after it takes the next
   * one, so browsing costs one request rather than one per click; exhausting a page fetches the one after it.
   */
  /**
   * Built-in and generated themes read in a style other than the one they were composed in. Unlike a hunted
   * palette, these cannot be rebuilt from their id alone — it only names the theme they came from — so the one on
   * screen is held here and an installed one is re-read from the list on open.
   */
  const [repainted, setRepainted] = useState<ThemeDocument[]>([]);
  const hunt = useRef<{ palettes: PaletteLike[]; cursor: number; step: number }>({ palettes: [], cursor: 0, step: 0 });
  /**
   * How a palette reaches the sections: the wash the studio has always used, or the brand-and-accent-levels
   * reading of the same four colors. It decides what the next shuffle builds, and repaints what is already chosen.
   */
  const [paint, setPaint] = useState<PaintStyle>(DEFAULT_PAINT);
  const [hunting, setHunting] = useState(false);
  const [huntError, setHuntError] = useState<string | undefined>(undefined);
  const [hoveredNode, setHoveredNode] = useState<DesignNode | undefined>(undefined);
  const [selectedNode, setSelectedNode] = useState<DesignNode | undefined>(undefined);
  // The edit in flight during a drag, committed to the document on release.
  const pendingEdit = useRef<{ name: string; nodeId: string; patch: Style } | undefined>(undefined);

  // Presets live in Convex. Summaries drive the library; trees are fetched only for what this page references,
  // including what the project was last composed from, so the install can tell an edited file from an untouched one.
  const catalog = useConvexQuery(api.presets.catalog, open ? {} : 'skip');
  const recipeRows = useConvexQuery(api.presets.recipes, open ? {} : 'skip');
  // The page's marker names its presets, so what to fetch is known before anything has loaded.
  const needed = [...new Set([...blocks.flatMap(block => (block.presetId ? [block.presetId] : [])), ...(open ? pagePresetIds(state.project) : [])])].sort();
  const documentRows = useConvexQuery(api.presets.documents, open && needed.length ? { presetIds: needed } : 'skip');
  const presets = presetsFor(catalog, documentRows);
  // Only diff against the project while the studio is open; the session changes on every keystroke.
  const saved = open ? readPage(state.project, presets) : [];
  const recipes: PresetRecipe[] = recipeRows ?? [];
  const themeRows = useConvexQuery(api.presets.themes, open ? {} : 'skip');
  const convex = useConvex();
  const savedThemeId = readProjectThemeId(state.project) ?? INHERIT_THEME.themeId;
  // A generated theme installed in an earlier session is rebuilt from the id in the stylesheet, so reopening the
  // studio finds it selected rather than silently falling back to Inherit and stripping it from the preview.
  const installedGenerated = open && !generated.some(theme => theme.themeId === savedThemeId) ? themeFromId(savedThemeId) : undefined;
  // A theme is only custom properties, so the whole list is small enough to hold and switching costs no rebuild.
  const installedHunted = open && !hunted.some(theme => theme.themeId === savedThemeId) ? themeFromHuntedId(savedThemeId) : undefined;
  const baseThemes: ThemeDocument[] = [INHERIT_THEME, ...hunted, ...(installedHunted ? [installedHunted] : []), ...generated, ...(installedGenerated ? [installedGenerated] : []), ...(themeRows ?? [])];
  // A repainted built-in or generated theme is its base id plus a style, so a project installed with one resolves
  // the base out of the list above and re-reads it, rather than dropping to Inherit and stripping the stylesheet.
  const savedPaint = open ? readPaintedId(savedThemeId) : undefined;
  const installedRepainted = savedPaint && !repainted.some(theme => theme.themeId === savedThemeId)
    ? repaintTheme(themeById(baseThemes, savedPaint.baseId), savedPaint.paint)
    : undefined;
  const themes: ThemeDocument[] = [...baseThemes, ...repainted, ...(installedRepainted?.themeId === savedThemeId ? [installedRepainted] : [])];
  const pageTheme = themeById(themes, themeId);
  const paintStyle = paintOf(pageTheme);
  const catalogLoading = open && catalog === undefined;
  // Composing and installing need every referenced tree and theme in hand; until then the studio waits rather than
  // writing a page with sections missing or replacing an applied theme with a loading fallback.
  const ready = open && themeRows !== undefined && presets.loaded(needed);

  const pageChanged = open && !samePage(blocks, saved);
  const themeChanged = open && themeId !== savedThemeId;
  const dirty = pageChanged || themeChanged;
  const themeOnly = themeChanged && !pageChanged;
  const install = ready && blocks.length ? planPageInstall(state.project, blocks, presets, pageTheme) : undefined;
  const upToDate = install !== undefined && Object.keys(install.files).length === 0 && install.removes.length === 0;
  const focused = blocks.find(block => block.name === selected) ?? blocks[0];
  const code = !focused ? '' : codeFile === 'page' ? composePage(blocks) : blockSource(state.project, focused, presets);
  const codePath = !focused ? '' : codeFile === 'page' ? PAGE_FILE : sectionFile(focused.name);
  const width = devices.find(candidate => candidate.id === device)!.width;
  const scale = stageSize.width ? Math.min(1, stageSize.width / width) : 1;
  // An identity transform would still promote the frame to its own layer, so it is left off at 100%.
  const frameStyle = stageSize.height
    ? { width: width + 'px', height: stageSize.height / scale + 'px', ...(scale === 1 ? {} : { transform: 'scale(' + scale + ')' }) }
    : { width: '100%', height: '100%' };
  const frameClass = 'absolute top-0 left-0 m-0 origin-top-left rounded-[6px] border border-edge shadow-elevation data-[front=false]:pointer-events-none data-[front=false]:opacity-0';
  /**
   * Maximised, the body is one column and the panels are hidden rather than unmounted — the theme designer holds
   * a brief, a design and its answers, and restoring the panels should not throw that away.
   */
  const bodyClass = maximized
    ? 'grid min-h-0 grid-cols-[minmax(0,1fr)]'
    : 'grid min-h-0 grid-cols-[300px_minmax(0,1fr)_252px] max-[1180px]:grid-cols-[280px_minmax(0,1fr)] max-[1180px]:grid-rows-[minmax(0,1fr)_minmax(0,42%)] max-[760px]:flex max-[760px]:flex-col max-[760px]:overflow-auto';
  const mainClass = cn('flex min-h-0 min-w-0 flex-col bg-canvas', !maximized && 'max-[1180px]:col-start-2 max-[1180px]:row-span-2 max-[1180px]:row-start-1 max-[760px]:order-3 max-[760px]:h-[80dvh] max-[760px]:shrink-0');
  const targetOf = (kind: SectionKindId) => (focused?.kind === kind ? focused : blocks.find(block => block.kind === kind));
  const designLabel = (block: PageBlock) => (block.presetId === undefined ? undefined : presets.summary(block.presetId)?.title) ?? 'Edited in code';

  const editedNodes = blocks.reduce((total, block) => total + overrideCount(block.overrides), 0);
  const clearDesign = () => setBlocks(blocks.map(block => ({ ...block, overrides: undefined })));
  const sectionWrites = install ? Object.keys(install.files).filter(path => path.startsWith('/src/sections/')).length : 0;
  const cleanups = install ? install.removes.filter(path => path.startsWith('/src/sections/')).length : 0;
  const installNote = !ready && blocks.length ? 'Loading the studio data this page uses…'
    : !blocks.length ? 'Add sections from the library or start from a recipe. Nothing changes in your project until you add the page.'
    : upToDate ? 'Your project already has this page. Edit the sections in code, or change the page here.'
    : [
      !pageChanged ? '' : install?.replacesStarter ? 'Replaces the starter app with your page.' : saved.length ? 'Updates Page.btsx.' : 'Adds Page.btsx and renders it at the top of App.btsx.',
      sectionWrites ? `Writes ${plural(sectionWrites, 'section file')} to src/sections.` : '',
      cleanups ? `Removes ${plural(cleanups, 'unused section')}.` : '',
      !themeChanged ? '' : pageTheme.themeId === INHERIT_THEME.themeId
        ? 'Removes the Design Studio theme from your stylesheet.'
        // Two readings of one palette share a name, so the note says which one is about to be written.
        : `Writes the ${pageTheme.name}${paintStyle ? ' (' + paintStyle.label + ')' : ''} theme into your stylesheet.`,
      editedNodes ? `Includes ${plural(editedNodes, 'Fine Layout edit')}.` : '',
      install?.rendered === false ? 'App.btsx could not be updated automatically, so import Page and render it where it belongs.' : ''
    ].filter(Boolean).join(' ');
  const overwriteNote = install?.overwrites.length ? `Replaces your edits to ${install.overwrites.map(fileLabel).join(', ')}.` : '';

  const reveal = (name: string) => {
    const index = blocks.findIndex(block => block.name === name);
    if (index >= 0) preview.current?.reveal(blockSelector(index), true);
  };
  const select = (name: string) => {
    const block = blocks.find(candidate => candidate.name === name);
    if (!block) return;
    setSelected(name);
    setOpenKind(block.kind);
    reveal(name);
  };
  const change = (next: PageBlock[], focus?: string) => {
    setBlocks(next);
    if (focus) { setSelected(focus); pendingReveal.current = { name: focus, highlight: true }; }
  };
  const addAnother = (presetId: string) => {
    const summary = presets.summary(presetId);
    if (!summary) return;
    const target = targetOf(summary.kind);
    const at = target ? blocks.findIndex(block => block.name === target.name) + 1 : undefined;
    const added = addSection(blocks, presetId, presets, at);
    change(added.blocks, added.name);
  };
  const chooseDesign = (presetId: string) => {
    const summary = presets.summary(presetId);
    if (!summary) return;
    const target = targetOf(summary.kind);
    if (!target) return addAnother(presetId);
    if (target.presetId === presetId) return select(target.name);
    change(swapPreset(blocks, target.name, presetId), target.name);
  };
  const remove = (name: string) => {
    const index = blocks.findIndex(block => block.name === name);
    const next = blocks.filter(block => block.name !== name);
    const neighbor = next[Math.min(index, next.length - 1)]?.name;
    setBlocks(next);
    if (selected === name) setSelected(neighbor);
    // Removing a section reloads the preview; land back where the section was.
    if (neighbor) pendingReveal.current = { name: neighbor, highlight: false };
  };
  // A stamped id carries the block it came from, so clicking a node in any section edits that section.
  const targetNode = selectedNode && readNodeId(selectedNode.nodeId);
  const targetBlock = targetNode && blocks.find(block => block.name === targetNode.name);
  const styleOf = () => {
    if (!targetBlock || !targetNode) return undefined;
    const document = blockDocument(state.project, targetBlock, presets);
    const node = document && nodeIndex(document).get(targetNode.nodeId);
    return node?.type === 'element' ? node.style : undefined;
  };
  const patchOf = (edits: DesignEdit[]): Style => {
    const style: Style = {};
    for (const edit of edits) {
      // Spacing stays in the theme's steps; a dimension is an explicit pixel value.
      if (edit.group === 'spacing') (style.spacing ??= {})[edit.field] = edit.value;
      else (style.size ??= {})[edit.field] = `[${edit.value}px]`;
    }
    return style;
  };
  const applyEdit = (edits: DesignEdit[], live: boolean) => {
    if (!targetNode || !targetBlock || !selectedNode) return;
    if (live) {
      const patch = patchOf(edits);
      pendingEdit.current = { name: targetNode.name, nodeId: targetNode.nodeId, patch };
      // Straight to the frame so the drag reads at pointer speed; the document catches up on release.
      preview.current?.applyDesignStyle(selectedNode.nodeId, toClasses(mergeStyle(styleOf(), patch)));
      return;
    }
    const pending = pendingEdit.current;
    pendingEdit.current = undefined;
    if (!pending) return;
    setBlocks(blocks.map(block => (block.name === pending.name
      ? { ...block, overrides: setNodeOverride(block.overrides, pending.nodeId, { style: pending.patch }) }
      : block)));
  };
  const resetNode = () => {
    if (!targetNode) return;
    setBlocks(blocks.map(block => (block.name === targetNode.name
      ? { ...block, overrides: clearNodeOverride(block.overrides, targetNode.nodeId) }
      : block)));
  };
  const receiveDesign = (event: { type: string; node?: DesignNode; nodeId?: string; text?: string }) => {
    if (event.type === 'hover') setHoveredNode(event.node);
    else if (event.type === 'out') setHoveredNode(undefined);
    else if (event.type === 'select') {
      setSelectedNode(event.node);
      // Follow the selection in the outline and the library, so the panels agree with the preview.
      const owner = event.node && readNodeId(event.node.nodeId);
      if (owner && owner.name !== selected) setSelected(owner.name);
    } else if (event.type === 'text' && event.nodeId) {
      const owner = readNodeId(event.nodeId);
      if (!owner) return;
      setBlocks(current => current.map(block => (block.name === owner.name
        ? { ...block, overrides: setNodeOverride(block.overrides, owner.nodeId, { text: [{ kind: 'literal', value: event.text ?? '' }] }) }
        : block)));
    }
  };
  const toggleDesigning = () => {
    const next = !designing;
    setDesigning(next);
    if (!next) { setSelectedNode(undefined); setHoveredNode(undefined); }
  };

  const startRecipe = (recipe: PresetRecipe) => {
    const next = recipeBlocks(recipe.presetIds, presets);
    change(next, next[0]?.name);
    setOpenKind(next[0]?.kind);
  };
  const discard = () => {
    setBlocks(saved);
    setSelected(saved[0]?.name);
    setThemeId(savedThemeId);
    session.setStudioThemePreview(undefined);
  };
  const chooseTheme = (nextThemeId: string) => {
    setThemeId(nextThemeId);
    // Choosing a palette that was painted in the other style moves the studio to it, so the next shuffle agrees
    // with what is on screen rather than silently going back to the style the panel still shows.
    const chosen = paintOfId(nextThemeId);
    if (chosen) setPaint(chosen);
    session.setStudioThemePreview(themeCss(themeById(themes, nextThemeId)));
  };
  /**
   * The same theme, read the other way.
   *
   * A repaint is a different theme with an id of its own, so both readings stay in the list and either can be
   * installed. Repainting always starts from the unpainted theme rather than from what is on screen, because a
   * painted document has already spent its ground and type on levels — which is also what makes going back to
   * Washed simply a matter of selecting the base again.
   *
   * A theme with nothing to re-read — Inherit, or a record whose colours the palette maths cannot parse — comes
   * back unchanged. The style is still remembered, so the next shuffle honours it.
   */
  const choosePaint = (next: PaintStyle) => {
    setPaint(next);
    const base = themeById(themes, readPaintedId(pageTheme.themeId)?.baseId ?? pageTheme.themeId);
    const chosen = repaintTheme(base, next);
    if (chosen.themeId === pageTheme.themeId) return;
    // A hunted palette rebuilds from its own id, so it belongs with the hunted ones; anything else is a reading of
    // a theme the list already holds and is kept beside it.
    const register = isHuntedTheme(chosen.themeId) ? setHunted : setRepainted;
    if (chosen.paint) register(current => [chosen, ...current.filter(existing => existing.themeId !== chosen.themeId)].slice(0, 12));
    setThemeId(chosen.themeId);
    session.setStudioThemePreview(themeCss(chosen));
  };
  /**
   * A theme from the designer, registered and selected in one step.
   *
   * Replacing by id rather than appending keeps the list from growing on every slider nudge, since a tweaked theme
   * carries the same aura but new coordinates. The preview repaints from the `setTokens` effect below.
   */
  const previewGenerated = (theme: ThemeDocument) => {
    setGenerated(current => [theme, ...current.filter(existing => existing.themeId !== theme.themeId)].slice(0, 12));
    setThemeId(theme.themeId);
    session.setStudioThemePreview(themeCss(theme));
  };
  /**
   * The next Color Hunt palette, registered and selected exactly like a generated one.
   *
   * The feed sends no CORS headers, so the request cannot be made from the browser and goes through the
   * `colorhunt.list` action instead — which is also why this needs a signed-in user.
   */
  const shuffle = async () => {
    if (!convex || hunting) return;
    setHunting(true);
    setHuntError(undefined);
    try {
      if (hunt.current.cursor >= hunt.current.palettes.length) {
        const palettes = await convex.action(api.colorhunt.list, { sort: 'random', step: hunt.current.step });
        if (!palettes.length) { setHuntError('Color Hunt sent no palettes.'); return; }
        hunt.current = { palettes, cursor: 0, step: hunt.current.step + 1 };
      }
      const theme = themeFromPalette(hunt.current.palettes[hunt.current.cursor], paint);
      hunt.current.cursor += 1;
      setHunted(current => [theme, ...current.filter(existing => existing.themeId !== theme.themeId)].slice(0, 12));
      setThemeId(theme.themeId);
      session.setStudioThemePreview(themeCss(theme));
    } catch (error) {
      // The action answers with a `ConvexError`, whose `data` carries the message worth showing.
      const data = (error as { data?: { message?: unknown } } | null)?.data;
      setHuntError(typeof data?.message === 'string' ? data.message : 'Could not reach Color Hunt.');
    } finally {
      setHunting(false);
    }
  };

  const show = () => {
    const page = readPage(state.project, presets);
    setBlocks(page);
    setSelected(page[0]?.name);
    setOpenKind(page[0]?.kind ?? 'topbar');
    const installed = readProjectThemeId(state.project) ?? INHERIT_THEME.themeId;
    setThemeId(installed);
    // A project already on a painted theme opens in the style it was painted in, so a shuffle continues from there.
    setPaint(paintOfId(installed) ?? DEFAULT_PAINT);
    setView('preview');
    setMaximized(false);
    if (window.matchMedia('(max-width: 760px)').matches) setDevice('mobile');
    setOpen(true);
    dialog.current?.showModal();
  };
  const closeFromButton = () => dialog.current?.close();
  const apply = () => {
    if (!install || upToDate) return;
    session.writeFiles(install.files, PAGE_FILE);
    for (const path of install.removes) session.deleteFile(path);
  };
  const copyCode = async () => {
    try { await navigator.clipboard.writeText(code); setCopied(true); }
    catch { setCopied(false); }
  };

  // Only the explicit close buttons dismiss the studio; platform close requests such as Escape are ignored.
  useEffect(() => {
    const element = dialog.current;
    if (!element) return;
    const onCancel = (event: Event) => {
      event.preventDefault();
      // Esc already reaches the dialog and is discarded; while maximised it restores the panels instead.
      if (maximizedRef.current) setMaximized(false);
    };
    const onClose = () => { setOpen(false); session.setStudioThemePreview(undefined); };
    element.addEventListener('cancel', onCancel);
    element.addEventListener('close', onClose);
    return () => { element.removeEventListener('cancel', onCancel); element.removeEventListener('close', onClose); session.setStudioThemePreview(undefined); element.close(); };
  }, [session]);
  // The compiler worker and iframe runtime only exist while the studio is open.
  useEffect(() => {
    if (!open || !frame.current || !standby.current) return;
    const instance = new TemplatePreview([frame.current, standby.current], theme, () => new Worker(new URL('../../playground/compiler.worker.ts', import.meta.url), { type: 'module' }), setStatus, 'Page preview');
    instance.hot = true;
    instance.onDesign = receiveDesign;
    preview.current = instance;
    setPreviewEpoch(epoch => epoch + 1);
    return () => { instance.dispose(); preview.current = null; };
  }, [open]);
  // Rebuild shortly after the page settles, so a drag or a burst of clicks compiles once.
  useEffect(() => {
    if (!open || !blocks.length || !ready) return;
    setStatus({ state: 'compiling' });
    const timer = setTimeout(() => {
      const focus = pendingReveal.current;
      pendingReveal.current = undefined;
      const index = focus === undefined ? -1 : blocks.findIndex(block => block.name === focus.name);
      preview.current?.show(pagePreviewProject(state.project, blocks, presets, designing), index >= 0 ? { selector: blockSelector(index), highlight: focus!.highlight } : undefined);
    }, 140);
    return () => clearTimeout(timer);
  }, [open, blocks, ready, designing, previewEpoch]);
  useEffect(() => {
    if (!open || !stage.current) return;
    const observer = new ResizeObserver(([entry]) => {
      const { width, height } = entry.contentRect;
      if (width && height) setStageSize({ width, height });
    });
    observer.observe(stage.current);
    return () => observer.disconnect();
  }, [open]);
  useEffect(() => { preview.current?.setTheme(theme); }, [theme]);
  useEffect(() => { preview.current?.setTokens(themeCss(pageTheme)); }, [open, themeId, themeRows, generated, hunted, repainted]);
  useEffect(() => { preview.current?.setDesigning(designing); }, [open, designing]);
  // A rebuild replaces the node that was measured, so the overlay asks the new one for its box.
  useEffect(() => {
    if (designing && status.state === 'ready' && selectedNode) preview.current?.measureNode(selectedNode.nodeId);
  }, [status, designing]);
  // The preview must carry `data-node` to be inspectable, so entering or leaving Fine Layout rebuilds it once.
  useEffect(() => { if (open && blocks.length) setStatus({ state: 'compiling' }); }, [designing]);
  useEffect(() => { setCopied(false); }, [code]);

button(className='bg-background dark:bg-muted/50 hover:dark:bg-muted py-1.5 px-3 rounded-2xl transition-colors duration-180 ease-out' type='button' title={compact ? 'Open Design Studio' : undefined} onClick={event => { event.currentTarget.focus(); show(); }})
  div(className='flex items-center justify-center rounded-full gap-1.5')
    Icon(name='design' className='size-4 text-accent')
    if !compact
      span(className='font-sans text-muted-foreground text-sm -tracking-[0.02em] truncate capitalize') Design Studio
dialog(className={cn(dialogPanel, 'h-[min(920px,calc(100dvh-24px))] w-[min(1440px,calc(100vw-24px))] max-h-none overflow-hidden p-0 open:grid grid-rows-[auto_minmax(0,1fr)_auto] light:rounded-2xl')} ref={dialog} aria-labelledby='design-studio-title')
  header(className='flex flex-wrap items-center justify-between gap-x-6 border-b border-edge-strong px-5 py-3')
    div(className='min-w-0 -space-y-1.5')
      div(className='flex flex-wrap items-baseline gap-x-3')
        h2#design-studio-title(className='font-semibold text-foreground/80 text-lg -tracking-[0.028em]') Design Studio
      span(className='font-serif script text-brand/80 text-sm') for web apps
    div(className='flex items-center justify-center gap-2')
      span(className='hidden font-code text-[10px] text-faint sm:inline' title='Preview width and zoom') #{width}px · #{Math.round(scale * 100)}%
      div(className='flex gap-0.5 rounded-[6px] border border-edge bg-inset p-0.5' role='radiogroup' aria-label='Preview size')
        each option in devices key option.id
          button(
            ~ type='button'
            ~ role='radio'
            ~ aria-checked={device === option.id}
            ~ aria-label={option.label}
            ~ title={option.label}
            ~ className='flex size-7 items-center justify-center rounded-[4px] text-dim hover:text-fg aria-checked:bg-control aria-checked:text-brand aria-checked:shadow-xs'
            ~ onClick={() => setDevice(option.id)}
            ~ )
            Icon(name={option.icon} className='size-3.5')
      button(
        ~ type='button'
        ~ aria-pressed={maximized}
        ~ aria-label={maximized ? 'Show the side panels' : 'Maximize the preview'}
        ~ title={maximized ? 'Show the library and outline (Esc)' : 'Hide the side panels and fill the studio with the preview'}
        ~ className='flex size-7 items-center justify-center rounded-[4px] text-dim hover:text-fg aria-pressed:bg-control aria-pressed:text-brand'
        ~ onClick={() => setMaximized(value => !value)}
        ~ )
        span ⛶
    div(className='flex items-center gap-2')
      button(
        ~ type='button'
        ~ aria-pressed={designing}
        ~ disabled={!blocks.length || view === 'code'}
        ~ title='Hover the preview to inspect a section, then drag its padding, margin or size'
        ~ className='flex items-center gap-1.5 rounded-[6px] p-1 text-dim transition-colors hover:text-brand aria-pressed:text-brand disabled:opacity-40 aria-pressed:border-brand'
        ~ onClick={toggleDesigning}
        ~ )
        Icon(name='layout' className='size-5' )
        // span Fine Layout
      div(className='flex items-center gap-1.5')
        if huntError
          span(className='max-w-44 truncate text-[10px] text-warning' title={huntError}) #{huntError}
        ThemePicker(
          ~ themes={themes}
          ~ themeId={themeId}
          ~ onChoose={chooseTheme}
          ~ paint={paint}
          ~ onPaint={choosePaint}
          ~ onShuffle={shuffle}
          ~ shuffling={hunting}
          ~ shuffleBlocked={convex ? undefined : 'Color Hunt needs a Convex connection.'}
          ~ container={dialog}
          ~ )

      Button(variant='ghost' size='icon' aria-label='Close Design Studio' onClick={closeFromButton} className='relative -translate-y-3 translate-x-3') ×

  div(className={bodyClass})
    aside(className={cn('flex min-h-0 flex-col border-r border-edge bg-panel-deep max-[1180px]:row-start-1 max-[760px]:order-2 max-[760px]:h-[70dvh] max-[760px]:shrink-0 max-[760px]:border-r-0 max-[760px]:border-b', maximized && 'hidden')} aria-label='Section library')
      SectionLibrary(blocks={blocks} presets={presets} targetOf={targetOf} openKind={openKind} onOpenKind={setOpenKind} onUse={chooseDesign} onAdd={addAnother})
    main(className={mainClass})
      div(className='flex items-center justify-between gap-3 border-b border-edge bg-surface-toolbar px-2.5 py-1.5')
        div(className='flex gap-0.5' role='tablist' aria-label='Studio view')
          button(className='rounded-[4px] px-2.5 py-1 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={view === 'preview'} onClick={() => setView('preview')}) Preview
          button(className='rounded-[4px] px-2.5 py-1 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg disabled:opacity-50' type='button' role='tab' aria-selected={view === 'code'} disabled={!blocks.length} onClick={() => setView('code')}) Code
        if view === 'code' && focused
          div(className='flex min-w-0 items-center gap-1.5')
            div(className='flex min-w-0 gap-0.5' role='tablist' aria-label='File')
              button(className='truncate rounded-[4px] px-2 py-1 font-code text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={codeFile === 'section'} onClick={() => setCodeFile('section')}) #{fileLabel(sectionFile(focused.name))}
              button(className='truncate rounded-[4px] px-2 py-1 font-code text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={codeFile === 'page'} onClick={() => setCodeFile('page')}) Page.btsx
            button(className='shrink-0 rounded-[4px] px-2 py-1 text-[10px] text-fg-secondary hover:bg-control hover:text-fg' type='button' onClick={copyCode}) #{copied ? 'Copied ✓' : 'Copy'}
        else
          span(className='min-w-0 truncate font-code text-[10px] text-faint data-[state=error]:text-warning' role='status' data-state={blocks.length ? status.state : 'idle'})
            | #{!blocks.length ? (catalogLoading ? 'Loading sections…' : 'Empty page') : !ready ? 'Loading sections…' : status.state === 'compiling' ? 'Building preview…' : status.state === 'error' ? status.message : focused ? sectionKind(focused.kind).label + ' · ' + designLabel(focused) : ''}
      div(className='relative min-h-0 flex-1')
        div(className='absolute inset-3' ref={stage} hidden={view !== 'preview'})
          div(className='relative mx-auto h-full transition-[width] duration-300 ease-out' style={{ width: stageSize.width ? width * scale + 'px' : '100%' }})
            iframe(ref={frame} style={frameStyle} className={frameClass})
            iframe(ref={standby} style={frameStyle} className={frameClass})
            if designing && ready
              DesignOverlay(
                ~ selected={selectedNode}
                ~ hovered={hoveredNode}
                ~ scale={scale}
                ~ edited={!!targetNode && !!targetBlock?.overrides?.[targetNode.nodeId]}
                ~ onEdit={applyEdit}
                ~ onEditText={() => selectedNode && preview.current?.editText(selectedNode.nodeId, true)}
                ~ onReset={resetNode}
                ~ onDismiss={() => setSelectedNode(undefined)}
                ~ )
          if !blocks.length
            div(className='absolute inset-0 flex flex-col items-center justify-center gap-5 rounded-[6px] border border-dashed border-edge-strong bg-canvas p-6 text-center')
              Icon(name='design' className='size-7 text-brand')
              div
                p(className='text-[15px] font-medium text-fg') Start with a recipe, or pick sections one by one
                p(className='mt-1 text-[11px] text-dim') Every section is a real Beast component styled with Tailwind, and it follows your theme.
              if catalogLoading
                p(className='text-[11px] text-dim' role='status') Loading the section catalog…
              else
                div(className='grid w-full max-w-2xl gap-2 sm:grid-cols-2')
                  each recipe in recipes key recipe.recipeId
                    button(type='button' className='grid gap-1 rounded-[6px] border border-edge bg-surface-recessed p-3 text-left hover:border-brand hover:bg-surface-hover' onClick={() => startRecipe(recipe)})
                      span(className='flex items-baseline justify-between gap-2')
                        span(className='text-[12px] text-fg') #{recipe.title}
                        span(className='font-code text-[9px] text-faint') #{plural(recipe.presetIds.length, 'section')}
                      span(className='text-[10px] leading-[1.5] text-dim') #{recipe.description}
                  empty
                    p(className='text-[11px] text-dim' role='status') No recipes are published yet.
        if view === 'code'
          pre(className='absolute inset-0 m-0 overflow-auto bg-inset p-4 font-code text-[11px]/[1.75] text-fg-secondary' aria-label={fileLabel(codePath)}) #{code}
    aside(className={cn('flex min-h-0 flex-col border-l border-edge bg-panel-deep max-[1180px]:col-start-1 max-[1180px]:row-start-2 max-[1180px]:border-t max-[1180px]:border-l-0 max-[1180px]:border-r max-[760px]:order-1 max-[760px]:max-h-[45dvh] max-[760px]:shrink-0 max-[760px]:border-r-0 max-[760px]:border-b', maximized && 'hidden')} aria-label='Page outline and theme')
      div(className='flex h-9 shrink-0 gap-0.5 border-b border-edge bg-surface-toolbar px-1.5 py-1.5' role='tablist' aria-label='Right panel')
        button(className='rounded-[4px] px-2 py-0.5 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={asidePanel === 'outline'} onClick={() => setAsidePanel('outline')}) Outline
        button(className='flex items-center gap-1 rounded-[4px] px-2 py-0.5 text-[10px] text-dim aria-selected:bg-control aria-selected:text-fg' type='button' role='tab' aria-selected={asidePanel === 'theme'} onClick={() => setAsidePanel('theme')})
          Icon(name='sparkle' className='size-2.5')
          span Theme
      if asidePanel === 'theme'
        ThemeDesigner(onPreview={previewGenerated} current={pageTheme})
      else
        PageOutline(blocks={blocks} presets={presets} recipes={recipes} selected={focused?.name} onSelect={select} onReorder={next => setBlocks(next)} onRemove={remove} onRecipe={startRecipe})

  footer(className='flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-edge-strong px-5 py-3')
    p(className='min-w-0 flex-1 basis-80 text-[11px] leading-[1.6] text-dim' role='status')
      span #{installNote}
      if overwriteNote
        span(className='ml-1 text-warning') #{overwriteNote}
    div(className='flex shrink-0 items-center gap-[7px]')
      if editedNodes
        button(className='rounded-[5px] px-2 py-1 text-[10px] text-warning hover:bg-control' type='button' title='Drop every Fine Layout edit and go back to the presets' onClick={clearDesign}) Reset #{plural(editedNodes, 'edit')}
      if dirty && saved.length
        button(className={secondaryButton} type='button' onClick={discard}) Discard changes
      button(className={secondaryButton} type='button' onClick={closeFromButton}) Close
      button(className={cn(primaryButton, 'disabled:cursor-default disabled:opacity-60')} type='button' disabled={!install || upToDate} onClick={apply}) #{upToDate ? 'Page is up to date' : themeOnly ? 'Apply theme' : saved.length ? 'Update page' : 'Add page to project'}
