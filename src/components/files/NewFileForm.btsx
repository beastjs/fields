import { useEffect, useRef } from 'octane'
import { useField, useForm } from '@octanejs/tanstack-form'
import type { PlaygroundSession } from '../../playground/session'

props { session, onCreate, onCancel }: { session: PlaygroundSession; onCreate: (name: string) => void; onCancel: () => void }
setup
  const input = useRef<HTMLInputElement | null>(null);
  const form = useForm({ defaultValues: { path: '' }, onSubmit: ({ value }) => onCreate(value.path) });
  const field = useField({ form, name: 'path', validators: {
    onChange: ({ value }) => session.validateNewFile(value),
    onSubmit: ({ value }) => session.validateNewFile(value),
  } });
  const errors = field.state.meta.errors;
  const formButton = 'mr-1 rounded-[3px] border border-edge-strong bg-edge px-2 py-1';
  useEffect(() => { input.current?.focus(); }, []);
  const submit = (event: SubmitEvent) => { event.preventDefault(); void form.handleSubmit(); };

form#new-file-form(className='mx-3 mt-0.5 mb-2.5 text-[10px]' onSubmit={submit})
  label(className='mb-1.5 block text-dim' for='new-file-name') New file path
  input#new-file-name(className='mb-[7px] w-full rounded-[4px] border border-edge-strong bg-inset p-2 text-fg' ref={input} type='text' placeholder='src/Component.btsx' autocomplete='off' value={field.state.value} onInput={(event) => field.handleChange(event.currentTarget.value)} onBlur={field.handleBlur} aria-invalid={errors.length > 0} aria-describedby={errors.length ? 'file-error' : undefined})
  button(className={formButton} type='submit') Add
  button#cancel-file(className={formButton} type='button' onClick={onCancel}) Cancel
  p#file-error(className='text-[10px] leading-[1.6] text-[#e9b747] light:text-destructive' role='alert' hidden={!errors.length}) #{errors.join(' ')}
