import { useRef, useState, useSyncExternalStore } from 'octane'
import { useField, useForm } from '@octanejs/tanstack-form'
import { fileIcon, fileLabel } from '../../playground/presentation'
import PaneSurface from '../layout/PaneSurface.btsx'
import CollapseButton from '../layout/CollapseButton.btsx'
import NewFileForm from './NewFileForm.btsx'
import type { WorkspaceProps, NavigateToSource } from '../types'
import {Icon} from '@/lib/icons'
import { cn } from '@/lib/utils'
import { iconButton, statusDot } from '../ui/styles'
import type { Diagnostic } from '../../playground/contracts'

module
  interface FileAttention { severity: 'error' | 'warning'; count: number }
  // Worst severity and issue count per file; info diagnostics don't need attention.
  const attentionByFile = (diagnostics: Diagnostic[]) => {
    const attention = new Map<string, FileAttention>();
    for (const diagnostic of diagnostics) {
      if (diagnostic.severity === 'info') continue;
      const current = attention.get(diagnostic.file);
      attention.set(diagnostic.file, {
        severity: current?.severity === 'error' ? 'error' : diagnostic.severity,
        count: (current?.count ?? 0) + 1,
      });
    }
    return attention;
  };
  const attentionLabel = ({ severity, count }: FileAttention) => count + ' ' + (severity === 'error' ? 'error' : 'warning') + (count === 1 ? '' : 's');

props { session, layout, navigate }: WorkspaceProps & { navigate: NavigateToSource }
setup
  const state = useSyncExternalStore(session.subscribe, session.getSnapshot);
  const [adding, setAdding] = useState(false);
  const addButton = useRef<HTMLButtonElement | null>(null);
  const searchForm = useForm({ defaultValues: { search: '' } });
  const search = useField({ form: searchForm, name: 'search' });
  const files = Object.keys(state.project.files).filter(path => fileLabel(path).toLowerCase().includes(search.state.value.toLowerCase()));
  const create = (name: string) => {
    layout.expand('editor');
    session.addFile(name);
    search.handleChange('');
    setAdding(false);
  };
  const cancel = () => { setAdding(false); addButton.current?.focus(); };
  const attention = attentionByFile(state.diagnostics);

PaneSurface(layout={layout} pane='files' label='File explorer' className='flex flex-col bg-panel-deep')
  div(className='mb-1.5 flex h-9 shrink-0 items-center gap-2 rounded-[4px] bg-inset px-[11px] text-dim shadow-[inset_0_1px_3px_#18181855] light:rounded-lg light:bg-control light:shadow-none')
    svg(width='17' height='17' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' aria-hidden={true})
      circle(cx='10.5' cy='10.5' r='6.5')
      path(d='m16 16 4.5 4.5')
    input(type='search' aria-label='Search files' placeholder='Search files…' value={search.state.value} onInput={event => search.handleChange(event.currentTarget.value)} className='w-full min-w-0 border-0 bg-transparent py-[9px] text-[11px] text-fg ring-0 outline-none')
  div(className='flex min-h-[42px] shrink-0 items-center justify-between px-2.5 text-[10px] tracking-[0.4px] text-fg-secondary')
    div(className='flex min-w-0 items-center gap-1')
      span PROJECT FILES
    div(className='flex items-center gap-0.5')
      button#add-file(className={iconButton} ref={addButton} type='button' onClick={() => setAdding(true)} aria-label='Add file' title='Add file')
        Icon(name='plus' className='size-3')
      CollapseButton(layout={layout} pane='files')
  if adding
    NewFileForm(session={session} onCreate={create} onCancel={cancel})
  div(className='flex items-center gap-[7px] px-2.5 pt-2 pb-3 text-[11px] text-dim')
    Icon(name='folder' className='size-3')
    | src
  div#file-list
    each path in files key path
      div(className={cn('file-row group/row relative mx-1 flex min-h-6 w-[calc(100%-16px)] items-center rounded-[5px] border border-transparent hover:bg-surface-hover', state.activeFile === path && 'border-edge-strong bg-[linear-gradient(var(--edge),var(--edge))] shadow-[inset_0_1px_#61615744] light:border-transparent light:bg-panel light:bg-none light:shadow-elevation')})
        button(className={cn('flex w-full items-center gap-2 overflow-hidden border-0 bg-none p-2 text-left text-fg-secondary max-[1050px]:pl-2.5', state.activeFile === path && 'text-fg')} type='button' title={attention.has(path) ? path + ' · ' + attentionLabel(attention.get(path)!) : path} aria-label={'Open ' + fileLabel(path) + (attention.has(path) ? ', ' + attentionLabel(attention.get(path)!) : '')} onClick={() => navigate(path)})
          span(className={cn('font-sans text-sm text-dim', state.activeFile === path && 'text-brand')}) #{fileIcon(path)}
          span(className='truncate font-sans text-sm') #{fileLabel(path)}
          if attention.has(path)
            span.file-attention-badge(className={cn('ml-auto size-1.5 shrink-0 rounded-full', attention.get(path)!.severity === 'error' ? 'bg-destructive shadow-[0_0_0_3px_color-mix(in_srgb,var(--destructive)_18%,transparent)]' : 'bg-warning shadow-[0_0_0_3px_color-mix(in_srgb,var(--warning)_18%,transparent)]')} data-severity={attention.get(path)!.severity} aria-hidden='true')
        if path !== state.project.entry
          button(className='invisible absolute top-2 right-[5px] border-0 bg-control px-1 text-fg-secondary group-focus-within/row:visible group-hover/row:visible' type='button' aria-label={'Delete ' + fileLabel(path)} onClick={() => session.deleteFile(path)}) ×
    if !files.length
      p(className='m-4 text-[11px] text-dim') No matching files.
  div(className='mx-[19px] mt-auto mb-[19px] pt-[26px] text-[9px] text-dim')
    span(className={cn(statusDot, 'mr-1.5 size-1')})
    span Local project
    p(className='mt-2 text-[9px] text-faint') #{state.saveStatus.issue ? 'Changes stay in this tab.' : 'Files save in this browser.'}
