{
  "name": "play",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dev": "bun run prepare:runtime && rsbuild dev",
    "build": "bun run prepare:runtime && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "bun run prepare:runtime && bun scripts/typecheck.ts && tsrx-tsc --noEmit -p tsconfig.tests.json",
    "test": "bun run prepare:runtime && bun test tests",
    "test:browser": "playwright test",
    "test:browser:hosted": "playwright test --config playwright.hosted.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "probe:isolation": "bun run prepare:runtime && bun scripts/probe-preview-isolation.mjs",
    "seed:presets": "bun run scripts/seed-presets.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@ai-sdk/provider-utils": "^5.0.58",
    "@beastjs/devtools": "^0.1.21",
    "@beastjs/metal-fx": "^2.0.1",
    "@beastjs/thinking-orbs": "^1.0.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@convex-dev/agent": "0.7.7",
    "@convex-dev/ai-sdk-provider": "0.3.0",
    "@convex-dev/rate-limiter": "0.4.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lezer/highlight": "1.2.5",
    "@octanejs/base-ui": "0.1.65",
    "@octanejs/dnd-kit": "^0.1.58",
    "@octanejs/nuqs": "0.1.52",
    "@octanejs/radix": "^0.1.65",
    "@octanejs/resizable-panels": "^0.0.22",
    "@octanejs/tanstack-form": "0.0.60",
    "@replit/codemirror-vim": "6.4.0",
    "ai": "^7.0.137",
    "beast-tsrx": "^0.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "dompurify": "3.4.16",
    "effect": "^3.22.2",
    "es-module-lexer": "3.0.3",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "highlight.js": "^11.12.0",
    "magic-string": "1.4.3",
    "marked": "18.1.0",
    "octane": "0.12.1",
    "path-browserify": "1.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@octanejs/rsbuild-plugin": "0.1.63",
    "@playwright/test": "1.64.0",
    "@rsbuild/core": "^2.2.12",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tsrx/oxc": "0.20.0",
