{
  "name": "play",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dev": "bun run prepare:runtime && rsbuild dev",
    "build": "bun run prepare:runtime && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "bun run prepare:runtime && tsrx-tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "bun run prepare:runtime && bun test tests",
    "test:browser": "playwright test",
    "test:browser:hosted": "playwright test --config playwright.hosted.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "probe:isolation": "bun run prepare:runtime && bun scripts/probe-preview-isolation.mjs",
    "seed:presets": "bun run scripts/seed-presets.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.14",
    "@ai-sdk/provider-utils": "^5.0.40",
    "@beastjs/metal-fx": "^2.0.0",
    "@beastjs/thinking-orbs": "^1.0.0",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@convex-dev/agent": "0.7.2",
    "@convex-dev/ai-sdk-provider": "0.1.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lezer/highlight": "1.2.3",
    "@octanejs/base-ui": "0.1.52",
    "@octanejs/dnd-kit": "^0.1.47",
    "@octanejs/nuqs": "0.1.41",
    "@octanejs/radix": "^0.1.52",
    "@octanejs/resizable-panels": "^0.0.10",
    "@octanejs/tanstack-form": "0.0.48",
    "@replit/codemirror-vim": "6.4.0",
    "ai": "^7.0.99",
    "beast-tsrx": "^0.2.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.124",
    "dompurify": "3.4.15",
    "es-module-lexer": "3.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "highlight.js": "^11.12.0",
    "magic-string": "1.3.1",
    "marked": "18.0.13",
    "octane": "0.2.10",
    "path-browserify": "1.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@octanejs/rsbuild-plugin": "0.1.49",
    "@playwright/test": "1.63.0",
    "@rsbuild/core": "^2.2.2",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tsrx/typescript-plugin": "0.3.138",
    "@types/bun": "1.4.2",
    "@types/node": "^26.5.1",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
