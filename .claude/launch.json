{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "hosting",
      "runtimeExecutable": "hosting/node_modules/.bin/wrangler",
      "runtimeArgs": [
        "dev",
        "--local",
        "--config",
        "hosting/wrangler.jsonc",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787,
      "url": "http://127.0.0.1:8787"
    }
  ]
}
